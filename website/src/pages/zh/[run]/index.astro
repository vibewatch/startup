---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DiligenceReport from '../../../components/DiligenceReport.astro';
import { loadStageFiles, loadStageFilesZh, type ReportStageFiles, type ReportStageFilesZh } from '../../../content/reports-loader';
import { localePath } from '../../../lib/locale';
import { currentReports } from '../../../lib/reports';

export async function getStaticPaths() {
  const reports = currentReports(await getCollection('reports'));
  return reports.map((entry) => ({ params: { run: entry.data.folderSlug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'reports'> };
const stages: ReportStageFiles = loadStageFiles(entry.id);
const stagesZh: ReportStageFilesZh = loadStageFilesZh(entry.id);
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title={`${entry.data.company.name} — 初创公司尽调`}
  description={entry.data.headline}
  locale="zh"
  alternateLocaleHref={localePath(base, 'en', entry.data.folderSlug)}
>
  <DiligenceReport entry={entry} data={entry.data} stages={stages} stagesZh={stagesZh} locale="zh" />
</BaseLayout>
