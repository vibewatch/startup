---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DiligenceReport from '../../components/DiligenceReport.astro';
import { loadStageFiles, type ReportStageFiles } from '../../content/reports-loader';
import { localePath } from '../../lib/locale';
import { currentReports } from '../../lib/reports';

export async function getStaticPaths() {
  const reports = currentReports(await getCollection('reports'));
  return reports.map((entry) => ({ params: { run: entry.data.folderSlug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'reports'> };
const stages: ReportStageFiles = loadStageFiles(entry.id);
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title={`${entry.data.company.name} — Startup Diligence`}
  description={entry.data.headline}
  alternateLocaleHref={localePath(base, 'zh', entry.data.folderSlug)}
>
  <DiligenceReport entry={entry} data={entry.data} stages={stages} />
</BaseLayout>
