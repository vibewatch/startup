---
import type { CollectionEntry } from 'astro:content';
import ClaimRefs from './ClaimRefs.astro';
import ReportBlock from './ReportBlock.astro';
import DataTable from './DataTable.astro';
import { displayLabel } from '../lib/display';
import { t } from '../lib/i18n';
import type { Locale } from '../lib/locale';
import { localePath } from '../lib/locale';
import { splitClaimRefsText, stripTrailingClaimRefs } from '../lib/claim-refs.mjs';
import type { ReportStageFiles, ReportStageFilesZh } from '../content/reports-loader';
import { asArray, asRecord, claimRefs, isRecord } from '../lib/report-types';
import type {
  Claim,
  CompanyProfile,
  CoverFact,
  EvidenceLedger,
  Founder,
  FullReport,
  ReportAppendix,
  ReportBlock as ReportBlockData,
  ReportChapter,
  ReportFigure,
  ReportSection,
  ReportTable,
  Source,
} from '../lib/report-types';

interface Props {
  entry: CollectionEntry<'reports'>;
  data: CollectionEntry<'reports'>['data'];
  stages: ReportStageFiles;
  locale?: Locale;
  // Optional Chinese overlay produced by loadStageFilesZh(). Each field is
  // null when the corresponding `*.zh.yaml` sibling has not been written yet;
  // mergeI18n() then falls back to the English text per leaf string.
  stagesZh?: ReportStageFilesZh | null;
}

const { data, stages, locale = 'en', stagesZh = null } = Astro.props;

// Recursive overlay: prefer the Chinese leaf when it is a non-empty string;
// otherwise keep the English original. Arrays and objects walk by index/key
// so a partial translation (e.g. only some sections translated) renders the
// translated parts in Chinese and the rest in English.
function mergeI18n(en: unknown, zh: unknown): unknown {
  if (zh === null || zh === undefined) return en;
  if (typeof en === 'string') {
    return typeof zh === 'string' && zh.trim() ? zh : en;
  }
  if (Array.isArray(en)) {
    if (!Array.isArray(zh)) return en;
    return en.map((item, i) => mergeI18n(item, zh[i]));
  }
  if (isRecord(en) && isRecord(zh)) {
    const out: Record<string, unknown> = { ...en };
    for (const key of Object.keys(en)) out[key] = mergeI18n(en[key], zh[key]);
    return out;
  }
  return en;
}

const base = import.meta.env.BASE_URL;
const revision = data.revision ?? { status: 'current', refreshOfFolderSlug: null, supersededByFolderSlug: null, refreshReason: null };
// Locale-aware cross-report links: from the zh detail page, point at the zh
// sibling of the related report. The folderSlug stays the same in both
// locales because it is derived from the runId, not the locale.
const refreshOfHref = revision.refreshOfFolderSlug
  ? (locale === 'zh' ? localePath(base, 'zh', revision.refreshOfFolderSlug) : `${base}${revision.refreshOfFolderSlug}/`)
  : null;
const supersededByHref = revision.supersededByFolderSlug
  ? (locale === 'zh' ? localePath(base, 'zh', revision.supersededByFolderSlug) : `${base}${revision.supersededByFolderSlug}/`)
  : null;

const enDoc = stages.fullReport as FullReport | null;
const enLedger = asRecord(stages.evidence) as EvidenceLedger;
const doc = (locale === 'zh' && stagesZh?.fullReport ? mergeI18n(enDoc, stagesZh.fullReport) : enDoc) as FullReport | null;
const ledger = enLedger;
const claims: Claim[] = asArray<Claim>(ledger.claims);
const sources: Source[] = asArray<Source>(ledger.sources);
const figureEntries: [string, ReportFigure][] = asArray<ReportFigure>(doc?.figures)
  .filter((figure): figure is ReportFigure & { id: string } => typeof figure.id === 'string' && !!figure.id)
  .map((figure) => [figure.id, figure]);
const tableEntries: [string, ReportTable][] = asArray<ReportTable>(doc?.tables)
  .filter((table): table is ReportTable & { id: string } => typeof table.id === 'string' && !!table.id)
  .map((table) => [table.id, table]);
const figures = new Map<string, ReportFigure>(figureEntries);
const tables = new Map<string, ReportTable>(tableEntries);

const labels = {
  recommendation: t('reportRecommendation', locale),
  confidence: t('reportConfidence', locale),
  riskRating: t('reportRiskRating', locale),
  valuationStance: t('reportValuationStance', locale),
  score: t('reportScore', locale),
  sources: t('reportSources', locale),
  claims: t('reportClaims', locale),
  figures: t('reportFigures', locale),
  tables: t('reportTables', locale),
  coverMetrics: t('reportCoverMetrics', locale),
  coverageNotes: t('reportCoverageNotes', locale),
  startupIntro: t('reportStartupIntro', locale),
  website: t('reportWebsite', locale),
  founded: t('reportFounded', locale),
  founders: t('reportFounders', locale),
  foundingLocation: t('reportFoundingLocation', locale),
  headquarters: t('reportHeadquarters', locale),
  product: t('reportProduct', locale),
  customers: t('reportCustomers', locale),
  businessModel: t('reportBusinessModel', locale),
  stage: t('reportStage', locale),
  fundingStatus: t('reportFundingStatus', locale),
  strengths: t('reportStrengths', locale),
  risks: t('reportRisks', locale),
  gaps: t('reportGaps', locale),
  contents: t('reportContents', locale),
  appendix: t('reportAppendix', locale),
  disclaimer: t('reportDisclaimer', locale),
  evidence: t('reportEvidence', locale),
  showRefs: t('reportShowRefs', locale),
  hideRefs: t('reportHideRefs', locale),
  executiveSummary: t('reportExecutiveSummary', locale),
  diligenceTag: t('reportDiligenceTag', locale),
  supersededBanner: t('reportSupersededBanner', locale),
  supersededFallback: t('reportSupersededFallback', locale),
  supersededLink: t('reportSupersededLink', locale),
  refreshedBanner: t('reportRefreshedBanner', locale),
  refreshedFallback: t('reportRefreshedFallback', locale),
  previousLink: t('reportPreviousLink', locale),
  downloadPdf: t('reportDownloadPdf', locale),
  printTooltip: t('reportPrintTooltip', locale),
  backToTop: t('reportBackToTop', locale),
  claimsCol: t('reportClaimsCol', locale),
  sourcesCol: t('reportSourcesCol', locale),
  claimIdCol: t('reportClaimIdCol', locale),
  claimStatementCol: t('reportClaimStatementCol', locale),
  claimConfidenceCol: t('reportClaimConfidenceCol', locale),
  claimSourcesCol: t('reportClaimSourcesCol', locale),
  sourceIdCol: t('reportSourceIdCol', locale),
  sourcePublisherCol: t('reportSourcePublisherCol', locale),
  sourceTitleCol: t('reportSourceTitleCol', locale),
  sourceQuoteCol: t('reportSourceQuoteCol', locale),
};

const fallbackMetricLabels = {
  valuation: t('cardValuation', locale),
  revenueRunRate: t('cardRevenue', locale),
  arr: t('cardArr', locale),
  growth: t('cardGrowth', locale),
  nrr: t('cardNrr', locale),
  totalRaised: locale === 'zh' ? '累计融资' : 'Total raised',
  customers: locale === 'zh' ? '客户数' : 'Customers',
  headcount: locale === 'zh' ? '员工数' : 'Headcount',
};

function arr<T = unknown>(value: unknown): T[] {
  return asArray<T>(value);
}

function metric(value: unknown, suffix = ''): string {
  if (value === null || value === undefined || value === '') return '—';
  if (typeof value === 'number') return `${value.toLocaleString()}${suffix}`;
  return String(value);
}

function moneyM(value: unknown): string {
  if (value === null || value === undefined || value === '') return '—';
  if (typeof value !== 'number') return String(value);
  if (Math.abs(value) >= 1000) {
    return `$${(value / 1000).toLocaleString(undefined, { maximumFractionDigits: 1 })}B`;
  }
  return `$${value.toLocaleString(undefined, { maximumFractionDigits: 1 })}M`;
}

function cleanHeadline(value: unknown): string {
  return stripTrailingClaimRefs(value);
}

function safeHttpUrl(value: unknown): string | null {
  if (typeof value !== 'string' || !/^https?:\/\//i.test(value)) return null;
  try {
    const url = new URL(value);
    return url.protocol === 'http:' || url.protocol === 'https:' ? url.href : null;
  } catch {
    return null;
  }
}

function blockRefs(value: unknown): string[] {
  return claimRefs(value);
}

const coverFacts = arr<CoverFact>(doc?.coverFacts);
const companyProfile = doc?.companyProfile
  ? {
      ...doc.companyProfile,
      summary: doc.companyProfile.summary ?? doc.companyProfile.body ?? null,
    } satisfies CompanyProfile
  : null;

const chapters = arr<ReportChapter>(doc?.chapters);
const appendices = arr<ReportAppendix>(doc?.appendices);
const founders = companyProfile ? arr<Founder>(companyProfile.founders) : [];

function sectionsFor(chapter: ReportChapter): ReportSection[] {
  return arr<ReportSection>(chapter.sections);
}

function blocksFor(container: ReportSection | ReportAppendix): ReportBlockData[] {
  return arr<ReportBlockData>(container.blocks);
}

const keyMetrics = data.keyMetrics ?? {};
const fallbackMetrics = [
  [fallbackMetricLabels.valuation, moneyM(keyMetrics.valuationUsdM)],
  [fallbackMetricLabels.revenueRunRate, moneyM(keyMetrics.revenueRunRateUsdM)],
  [fallbackMetricLabels.arr, moneyM(keyMetrics.arrUsdM)],
  [fallbackMetricLabels.growth, metric(keyMetrics.revenueGrowthYoYPct, '%')],
  [fallbackMetricLabels.nrr, metric(keyMetrics.nrrPct, '%')],
  [fallbackMetricLabels.totalRaised, moneyM(keyMetrics.totalRaisedUsdM)],
  [fallbackMetricLabels.customers, metric(keyMetrics.customerCount)],
  [fallbackMetricLabels.headcount, metric(keyMetrics.headcount)],
].filter(([, value]) => value !== '—');

// Card-level overlay: data.headline / topStrengths / topRisks /
// unresolvedGaps / company.shortDescription / company.sector come from the
// English summary-card.yaml (the Astro collection entry). When a Chinese
// summary-card.zh.yaml overlay is present, prefer its values per leaf and
// fall back to English for anything missing.
const zhCard = locale === 'zh' ? (stagesZh?.summaryCard ?? null) : null;
const zhSummary = asRecord(zhCard?.summary);
const zhCompany = asRecord(zhCard?.company);
const pickStr = (z: unknown, e: string | null | undefined) => (typeof z === 'string' && z.trim() ? z : e);
const pickArr = (z: unknown, e: string[]) => (Array.isArray(z) && z.length ? e.map((item, i) => (typeof z[i] === 'string' && z[i].trim() ? z[i] : item)) : e);
const card = {
  headline: pickStr(zhSummary.headline, data.headline),
  topStrengths: pickArr(zhSummary.topStrengths, arr<string>(data.topStrengths)),
  topRisks: pickArr(zhSummary.topRisks, arr<string>(data.topRisks)),
  unresolvedGaps: pickArr(zhSummary.unresolvedGaps, arr<string>(data.unresolvedGaps)),
  companySector: pickStr(zhCompany.sector, data.company?.sector),
  companyStage: pickStr(zhCompany.stage, data.company?.stage),
};
---
<section class="report-shell sr-container">
  {revision.status === 'superseded' && (
    <aside class="version-banner version-banner--superseded" aria-label="Superseded report notice">
      <strong>{labels.supersededBanner}</strong>
      <span>{revision.refreshReason ?? labels.supersededFallback}</span>
      {supersededByHref && <a href={supersededByHref}>{labels.supersededLink}</a>}
    </aside>
  )}
  {revision.status !== 'superseded' && refreshOfHref && (
    <aside class="version-banner version-banner--current" aria-label="Report refresh notice">
      <strong>{labels.refreshedBanner}</strong>
      <span>{revision.refreshReason ?? labels.refreshedFallback}</span>
      <a href={refreshOfHref}>{labels.previousLink}</a>
    </aside>
  )}
  <header class="report-cover">
    <div class="report-cover-main">
      <div class="cover-eyebrow">
        <span class="cover-eyebrow-tag">{labels.diligenceTag}</span>
        {card.companySector && <span class="cover-eyebrow-meta">{card.companySector}</span>}
        {card.companyStage && <span class="cover-eyebrow-meta">{card.companyStage}</span>}
        <span class="cover-eyebrow-meta">{data.runDate}</span>
      </div>
      <h1>{doc?.company?.name ?? data.company?.name ?? data.slug}</h1>
      {(doc?.subtitle ?? null) && <p class="report-subtitle">{doc?.subtitle}</p>}
      <p class="report-headline">{cleanHeadline(card.headline)}</p>
    </div>
    <aside class={`decision-card decision-${String(data.recommendation ?? 'unknown').replace(/[^a-z0-9-]/gi, '-')}`}>
      <div class="decision-headline">
        <span class="decision-eyebrow">{labels.recommendation}</span>
        <strong class="decision-rec">{displayLabel(data.recommendation, locale)}</strong>
      </div>
      <div class="decision-score">
        <span class="decision-score-value">{data.overallScore.toFixed(1)}</span>
        <span class="decision-score-label">{labels.score} / 10</span>
      </div>
      <dl class="decision-grid">
        <div><dt>{labels.confidence}</dt><dd>{displayLabel(data.confidence, locale)}</dd></div>
        <div><dt>{labels.riskRating}</dt><dd>{displayLabel(data.riskRating, locale)}</dd></div>
        <div><dt>{labels.valuationStance}</dt><dd>{displayLabel(data.valuationStance, locale)}</dd></div>
      </dl>
      <div class="decision-actions">
        <button
          type="button"
          class="evidence-toggle"
          aria-pressed="false"
          data-show-label={labels.showRefs}
          data-hide-label={labels.hideRefs}
        >{labels.showRefs}</button>
        <button
          type="button"
          class="print-pdf"
          data-print-pdf
          title={labels.printTooltip}
        >{labels.downloadPdf}</button>
      </div>
    </aside>
  </header>

  {doc?.coverageNotes?.trim() && (
    <section class="report-section coverage-notes" aria-labelledby="coverage-notes-title">
      <h2 id="coverage-notes-title">{labels.coverageNotes}</h2>
      <p>{doc.coverageNotes}</p>
    </section>
  )}

  <section class="report-section cover-metrics">
    <h2>{labels.coverMetrics}</h2>
    <div class="metric-grid">
      {coverFacts.length
        ? coverFacts.map((item, index) => (
            <article>
              <div class="metric-topline">
                <span class="metric-label">{item.label}</span>
                <em>{String(index + 1).padStart(2, '0')}</em>
              </div>
              <strong>{item.value == null ? '—' : `${item.value}${item.unit ? ` ${item.unit}` : ''}`}</strong>
              <ClaimRefs refs={blockRefs(item)} claims={claims} sources={sources} />
            </article>
          ))
        : fallbackMetrics.map(([label, value], index) => (
            <article>
              <div class="metric-topline">
                <span class="metric-label">{label}</span>
                <em>{String(index + 1).padStart(2, '0')}</em>
              </div>
              <strong>{value}</strong>
            </article>
          ))}
    </div>
  </section>

  {companyProfile && (
    <section class="report-section startup-intro">
      <h2>{labels.startupIntro}</h2>
      {companyProfile.heading && <p class="intro-heading"><strong>{companyProfile.heading}</strong></p>}
      {companyProfile.summary && (
        <p>
          {splitClaimRefsText(companyProfile.summary).map((part) => part.ref
            ? <ClaimRefs refs={[part.ref]} claims={claims} sources={sources} />
            : part.text)}
        </p>
      )}
      <dl class="intro-grid">
        {data.company?.website && /^https?:\/\//i.test(data.company.website) && (
          <div><dt>{labels.website}</dt><dd><a href={data.company.website} target="_blank" rel="noopener noreferrer">{data.company.website.replace(/^https?:\/\//i, '').replace(/\/$/, '')}</a></dd></div>
        )}
        {companyProfile.foundedDate && (
          <div><dt>{labels.founded}</dt><dd>{companyProfile.foundedDate}</dd></div>
        )}
        {founders.length > 0 && (
          <div><dt>{labels.founders}</dt><dd>{founders.map((founder) => founder.name).filter(Boolean).join(', ')}</dd></div>
        )}
        {companyProfile.foundingLocation && <div><dt>{labels.foundingLocation}</dt><dd>{companyProfile.foundingLocation}</dd></div>}
        {companyProfile.headquarters && <div><dt>{labels.headquarters}</dt><dd>{companyProfile.headquarters}</dd></div>}
        {companyProfile.productSummary && <div><dt>{labels.product}</dt><dd>{companyProfile.productSummary}</dd></div>}
        {companyProfile.customerFocus && <div><dt>{labels.customers}</dt><dd>{companyProfile.customerFocus}</dd></div>}
        {companyProfile.businessModel && <div><dt>{labels.businessModel}</dt><dd>{companyProfile.businessModel}</dd></div>}
        {companyProfile.stage && <div><dt>{labels.stage}</dt><dd>{companyProfile.stage}</dd></div>}
        {companyProfile.fundingStatus && <div><dt>{labels.fundingStatus}</dt><dd>{companyProfile.fundingStatus}</dd></div>}
      </dl>
      <ClaimRefs refs={(companyProfile.claimRefs ?? []).slice(0, 8)} claims={claims} sources={sources} />
    </section>
  )}

  {(card.topStrengths.length > 0 || card.topRisks.length > 0 || card.unresolvedGaps.length > 0) && (
    <section class="report-section executive-summary">
      <h2>{labels.executiveSummary}</h2>
      <div class="three-col">
        <article class="summary-card summary-strengths">
          <h2>{labels.strengths}</h2>
          <ul>
            {arr(card.topStrengths).map((item) => (
              <li>{splitClaimRefsText(item).map((part) => part.ref
                ? <ClaimRefs refs={[part.ref]} claims={claims} sources={sources} />
                : part.text)}</li>
            ))}
          </ul>
        </article>
        <article class="summary-card summary-risks">
          <h2>{labels.risks}</h2>
          <ul>
            {arr(card.topRisks).map((item) => (
              <li>{splitClaimRefsText(item).map((part) => part.ref
                ? <ClaimRefs refs={[part.ref]} claims={claims} sources={sources} />
                : part.text)}</li>
            ))}
          </ul>
        </article>
        <article class="summary-card summary-gaps">
          <h2>{labels.gaps}</h2>
          <ul>
            {arr(card.unresolvedGaps).map((item) => (
              <li>{splitClaimRefsText(item).map((part) => part.ref
                ? <ClaimRefs refs={[part.ref]} claims={claims} sources={sources} />
                : part.text)}</li>
            ))}
          </ul>
        </article>
      </div>
    </section>
  )}

  {chapters.length > 0 && (
    <section class="report-section toc-heading-section" id="contents">
      <h2>{labels.contents}</h2>
    </section>
  )}
  {chapters.length > 0 && (
    <nav class="toc-sticky" aria-label={labels.contents} data-toc>
      <ol class="toc-list" id="toc-list">
        {chapters.map((chapter) => (
          <li class="toc-item" data-toc-target={`chapter-${chapter.number}`}>
            <a href={`#chapter-${chapter.number}`}>
              <span class="toc-number">{String(chapter.number).padStart(2, '0')}</span>
              <span class="toc-title">{chapter.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )}

  {chapters.map((chapter) => (
    <article class="report-chapter" id={`chapter-${chapter.number}`}>
      <header class="chapter-header">
        <span class="chapter-eyebrow">Chapter {String(chapter.number).padStart(2, '0')}</span>
        <h2><span class="chapter-number">{String(chapter.number).padStart(2, '0')}</span><span class="chapter-title">{chapter.title}</span></h2>
      </header>
      {sectionsFor(chapter).map((section) => (
        <section class="chapter-section">
          <h3>{section.number} {section.title}</h3>
          {blocksFor(section).map((block) => (
            <ReportBlock block={block} tables={tables} figures={figures} claims={claims} sources={sources} />
          ))}
        </section>
      ))}
    </article>
  ))}

  {appendices.map((appendix) => (
    <section class="report-section appendix" id={`appendix-${appendix.id}`}>
      <h2>{labels.appendix} {appendix.id}: {appendix.title}</h2>
      {blocksFor(appendix).map((block) => (
        <ReportBlock block={block} tables={tables} figures={figures} claims={claims} sources={sources} />
      ))}
    </section>
  ))}

  {doc?.disclaimer && (
    <section class="report-section disclaimer"><h2>{labels.disclaimer}</h2><p>{doc.disclaimer}</p></section>
  )}

  {(claims.length > 0 || sources.length > 0) && (
    <section class="report-section evidence-index">
      <h2>{labels.evidence}</h2>
      {claims.length > 0 && (
        <DataTable title={labels.claimsCol} columns={[labels.claimIdCol, labels.claimStatementCol, labels.claimConfidenceCol, labels.claimSourcesCol]}>
          {claims.map((claim) => (
            <tr id={`claim-${claim.id}`}>
              <td><a class="evidence-id" href={`#claim-${claim.id}`}>{claim.id}</a></td>
              <td>{claim.statement}</td>
              <td>{displayLabel(claim.confidence, locale)}</td>
              <td>
                {(claim.sourceRefs ?? []).map((ref: string, index: number, list: string[]) => (
                  <>
                    <a href={`#source-${ref}`}>{ref}</a>{index < list.length - 1 ? ', ' : ''}
                  </>
                ))}
              </td>
            </tr>
          ))}
        </DataTable>
      )}
      {sources.length > 0 && (
        <DataTable title={labels.sourcesCol} columns={[labels.sourceIdCol, labels.sourcePublisherCol, labels.sourceTitleCol, labels.sourceQuoteCol]}>
          {sources.map((source) => {
            const sourceHref = safeHttpUrl(source.url);
            return (
              <tr id={`source-${source.id}`}>
                <td><a class="evidence-id" href={`#source-${source.id}`}>{source.id}</a></td>
                <td>{source.publisher}</td>
                <td>{sourceHref ? <a href={sourceHref}>{source.title}</a> : source.title}</td>
                <td>{source.keyQuote}</td>
              </tr>
            );
          })}
        </DataTable>
      )}
    </section>
  )}

  <button
    type="button"
    class="back-to-top"
    data-back-to-top
    aria-label={labels.backToTop}
    title={labels.backToTop}
    hidden
  >
    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
      <path d="M9 3.5 L9 14.5 M9 3.5 L4 8.5 M9 3.5 L14 8.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</section>

<script>
  const reportShell = document.querySelector('.report-shell');

  const printButton = document.querySelector('[data-print-pdf]');
  if (printButton) {
    printButton.addEventListener('click', () => {
      reportShell?.classList.add('print-mode');
      const restore = () => {
        reportShell?.classList.remove('print-mode');
        window.removeEventListener('afterprint', restore);
      };
      window.addEventListener('afterprint', restore);
      requestAnimationFrame(() => window.print());
    });
  }

  // Back-to-top floating button: appears after the user scrolls past the
  // cover (~600px), scrolls smoothly to the page top on click. Hidden in
  // print via the @media print rules.
  const backToTop = document.querySelector('[data-back-to-top]');
  if (backToTop) {
    const threshold = 600;
    let backToTopFrame = 0;
    const sync = () => {
      backToTopFrame = 0;
      const visible = window.scrollY > threshold;
      backToTop.toggleAttribute('hidden', !visible);
    };
    const scheduleSync = () => {
      if (!backToTopFrame) backToTopFrame = requestAnimationFrame(sync);
    };
    sync();
    window.addEventListener('scroll', scheduleSync, { passive: true });
    backToTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  const evidenceToggle = document.querySelector('.evidence-toggle');
  if (reportShell && evidenceToggle) {
    const showLabel = evidenceToggle.dataset.showLabel || 'Show refs';
    const hideLabel = evidenceToggle.dataset.hideLabel || 'Hide refs';
    const setRefsVisible = (visible) => {
      reportShell.classList.toggle('refs-visible', visible);
      evidenceToggle.setAttribute('aria-pressed', String(visible));
      evidenceToggle.textContent = visible ? hideLabel : showLabel;
    };
    evidenceToggle.addEventListener('click', () => {
      setRefsVisible(!reportShell.classList.contains('refs-visible'));
    });
    setRefsVisible(false);
  }

  // Sticky TOC: scroll-spy active state
  const tocNav = document.querySelector('[data-toc]');
  if (tocNav) {
    const items = Array.from(tocNav.querySelectorAll('.toc-item'));
    // Scroll-spy: highlight the toc-item whose target is currently most visible
    const targets = items
      .map((item) => {
        const id = item.getAttribute('data-toc-target');
        const el = id ? document.getElementById(id) : null;
        return el ? { item, el } : null;
      })
      .filter(Boolean);
    if (targets.length && 'IntersectionObserver' in window) {
      const visible = new Map();
      const setActive = (activeItem) => {
        items.forEach((item) => item.classList.toggle('is-active', item === activeItem));
      };
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
