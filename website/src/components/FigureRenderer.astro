    });
    if (hasDetails) {
      const detailY = compact ? 62 : 68;
      cards.append('text').attr('x', textX).attr('y', detailY).attr('fill', palette.muted).attr('font-size', compact ? chartFont.size.caption : chartFont.small).attr('font-weight', fontWeight('regular')).each(function(node) {
        const lines = textWrapper.wrap(node.detail, { fontSize: compact ? chartFont.size.caption : chartFont.small, fontWeight: fontWeight('regular'), maxWidth: cardW - textX * 2, maxLines: compact ? 2 : 3 });
        renderLineBlock(d3.select(this), lines, { x: textX, y: detailY, lineHeight: compact ? chartFont.lineHeight.compact : chartFont.lineHeight.small });
      });
    }
    cards.each(function(node) { addTitle(d3.select(this), [node.label, node.displayValue ?? node.value, ...figureValueNotes(node)].map(safeText).filter(Boolean).join('; ')); });
    withTooltip(cards, (node) => tooltipHtml(node.label, [safeText(node.displayValue ?? node.value), ...figureValueNotes(node)]));
    textWrapper.remove();
  };

  const firstNonEmpty = (...values) => values.find((value) => Array.isArray(value) && value.length > 0) ?? [];
  const normalizedItems = (data, itemLabel) => firstNonEmpty(data.items, data.nodes, data.layers, arr(data.series)[0]?.points, data.points).map((item, index) => ({ ...item, _index: index, label: item.label ?? item.name ?? item.id ?? `${itemLabel} ${index + 1}`, detail: figureDetail(item) ?? item.summary }));

  const createSvgTextWrapper = (svg) => {
    const measureText = svg.append('text').attr('visibility', 'hidden').attr('x', -9999).attr('y', -9999);
    const measureNode = measureText.node();
    let activeFontSize = null;
    let activeFontWeight = null;
    const setFont = (fontSize, fontWeight) => {
      if (fontSize === activeFontSize && fontWeight === activeFontWeight) return;
      measureText.attr('font-size', fontSize).attr('font-weight', fontWeight).attr('font-family', chartFont.family);
      activeFontSize = fontSize;
      activeFontWeight = fontWeight;
    };
    const widthCache = new Map();
    const measuredWidth = (value) => {
      const str = String(value ?? '');
      const key = `${activeFontSize}|${activeFontWeight}|${str}`;
      const cached = widthCache.get(key);
      if (cached !== undefined) return cached;
      measureText.text(str);
      const w = measureNode?.getComputedTextLength?.() ?? str.length * 8;
      widthCache.set(key, w);
      return w;
    };
    const splitTokenBySvgWidth = (token, maxWidth) => {
      const chunks = [];
      let chunk = '';
      Array.from(String(token ?? '')).forEach((char) => {
        const next = `${chunk}${char}`;
        if (chunk && measuredWidth(next) > maxWidth) {
          chunks.push(chunk);
          chunk = char;
        } else {
          chunk = next;
        }
      });
      if (chunk) chunks.push(chunk);
      return chunks;
    };
    const fit = (text, { fontSize, fontWeight, maxWidth }) => {
      const str = String(text ?? '');
      setFont(fontSize, fontWeight);
      if (measuredWidth(str) <= maxWidth) return str;
      if (measuredWidth('…') > maxWidth) return '';
      let prefix = '';
      for (const char of Array.from(str)) {
        if (measuredWidth(`${prefix}${char}…`) > maxWidth) break;
        prefix += char;
      }
      return `${prefix}…`;
    };
    const wrapCache = new Map();
    const wrap = (text, { fontSize, fontWeight, maxWidth, maxLines = Infinity }) => {
      const str = String(text ?? '');
      const cacheKey = `${fontSize}|${fontWeight}|${maxWidth}|${maxLines}|${str}`;
      const cached = wrapCache.get(cacheKey);
      if (cached) return cached;
      setFont(fontSize, fontWeight);
      const tokens = str.split(/\s+/).filter(Boolean);
      if (!tokens.length) {
        wrapCache.set(cacheKey, ['']);
        return [''];
      }
      const lines = [];
      let line = '';
      tokens.flatMap((token) => measuredWidth(token) > maxWidth ? splitTokenBySvgWidth(token, maxWidth) : token).forEach((token) => {
        const next = line ? `${line} ${token}` : token;
        if (line && measuredWidth(next) > maxWidth) {
          lines.push(line);
          line = token;
        } else {
          line = next;
        }
      });
      if (line) lines.push(line);
      if (lines.length > maxLines) {
        const last = fit(lines.slice(maxLines - 1).join(' '), { fontSize, fontWeight, maxWidth });
        lines.splice(maxLines - 1, lines.length, last);
      }
      wrapCache.set(cacheKey, lines);
      return lines;
    };
    return {
      wrap, fit,
      measure: (text, { fontSize, fontWeight }) => { setFont(fontSize, fontWeight); return measuredWidth(text); },
      remove: () => measureText.remove(),
    };
  };

  const renderTimeline = (element, payload) => {
    const items = normalizedItems(payload.data, payload.itemLabel);
    const margin = { top: 26, right: 34, bottom: 32, left: 34 };
    const containerWidth = Math.floor(element.getBoundingClientRect().width || 760);
    const width = containerWidth;
    const { svg } = svgBase(element, 260);
    const railX = margin.left + 20;
    const cardX = railX + 26;
    const cardW = width - railX - margin.right - 26;
    const textX = railX + 44;
    const textW = Math.max(80, cardW - 36);
    const textWrapper = createSvgTextWrapper(svg);
    const rowGap = 24;
    let cursorY = margin.top;
    const rowsData = items.map((item) => {
      const dateLines = textWrapper.wrap(item.date ?? item.period ?? item.year ?? item.label, { fontSize: chartFont.small, fontWeight: 900, maxWidth: textW });
      const labelLines = textWrapper.wrap(item.label, { fontSize: chartFont.label, fontWeight: 900, maxWidth: textW });
      const detailLines = textWrapper.wrap(item.detail, { fontSize: chartFont.small, fontWeight: 400, maxWidth: textW });
      const cardH = Math.max(78, 18 + dateLines.length * 15 + 8 + labelLines.length * 18 + 8 + detailLines.length * 15 + 16);
      const row = { ...item, dateLines, labelLines, detailLines, cardH, y: cursorY };
      cursorY += cardH + rowGap;
      return row;
    });
    const totalHeight = Math.max(260, cursorY - rowGap + margin.bottom);
    const displayHeight = Math.ceil(totalHeight * Math.min(1, containerWidth / width));
    svg.attr('viewBox', `0 0 ${width} ${totalHeight}`).attr('height', displayHeight);
    textWrapper.remove();
    svg.append('line').attr('x1', railX).attr('x2', railX).attr('y1', margin.top + 8).attr('y2', totalHeight - margin.bottom - 8).attr('stroke', palette.claret).attr('stroke-width', 2.4).attr('opacity', 0.8);
    const rows = svg.append('g').selectAll('g').data(rowsData).join('g').attr('transform', (d) => `translate(0,${d.y})`);
    rows.append('circle').attr('cx', railX).attr('cy', (d) => Math.min(32, d.cardH / 2)).attr('r', 9).attr('fill', (d) => colorForTone(d.tone)).attr('stroke', '#fff7ef').attr('stroke-width', 3);
    rows.append('rect').attr('x', cardX).attr('y', 0).attr('width', cardW).attr('height', (d) => d.cardH).attr('rx', 10).attr('fill', (d, index) => index % 2 === 0 ? 'rgba(153, 15, 61, 0.055)' : '#fff7ef').attr('stroke', palette.border);
    rows.append('text').attr('fill', palette.claret).attr('font-size', chartFont.small).attr('font-weight', fontWeight('label')).each(function(d) {
      renderLineBlock(d3.select(this), d.dateLines, { x: textX, y: 20, lineHeight: chartFont.lineHeight.small });
    });
    rows.append('text').attr('fill', palette.ink).attr('font-size', chartFont.label).attr('font-weight', fontWeight('label')).each(function(d) {
      renderLineBlock(d3.select(this), d.labelLines, { x: textX, y: 20 + d.dateLines.length * chartFont.lineHeight.small + 10, lineHeight: chartFont.lineHeight.title });
    });
    rows.append('text').attr('fill', palette.muted).attr('font-size', chartFont.small).each(function(d) {
      renderLineBlock(d3.select(this), d.detailLines, { x: textX, y: 20 + d.dateLines.length * chartFont.lineHeight.small + 10 + d.labelLines.length * chartFont.lineHeight.title + 10, lineHeight: chartFont.lineHeight.small });
    });
    rows.each(function(d) { addTitle(d3.select(this), `${d.date ?? ''} ${d.label}${d.detail ? ` — ${d.detail}` : ''}`); });
    withTooltip(rows, (d) => tooltipHtml(d.label, [d.date, d.detail]));
    const printEvents = d3.select(element).append('ol').attr('class', 'timeline-print-events');
    const printRows = printEvents.selectAll('li').data(rowsData).join('li')
      .style('border-left-color', (d) => colorForTone(d.tone));
    printRows.filter((d) => safeText(d.date ?? d.period ?? d.year).trim() !== '').append('p').text((d) => d.date ?? d.period ?? d.year);
    printRows.append('strong').text((d) => d.label);
    printRows.filter((d) => safeText(d.detail).trim() !== '').append('p').text((d) => d.detail);
  };

  const renderStack = (element, payload) => {
    const layers = stackLayerDetails(payload.data).map((layer) => ({
      ...layer.item, label: layer.label, detail: figureDetail(layer.item) ?? layer.item.summary, fullDetails: layer,
    }));
    const containerWidth = element.getBoundingClientRect().width || 760;
    const compact = containerWidth < 640;
    const margin = compact ? { top: 58, right: 24, bottom: 36, left: 24 } : { top: 62, right: 38, bottom: 40, left: 44 };
    const layerH = compact ? 96 : 104;
    const layerGap = compact ? 2 : 4;
    const { svg, width, height } = svgBase(element, Math.max(compact ? 480 : 540, margin.top + margin.bottom + layers.length * (layerH + layerGap) + 22));
    const maxW = width - margin.left - margin.right;
    const stackInset = compact ? 18 : 24;
    /* Typography for stack: bump one full step over the global chartFont
     * defaults so layer titles read as headings rather than captions. */
    const titleSize = compact ? chartFont.size.title : chartFont.size.large;       // 16 / 20
    const detailSize = compact ? chartFont.size.axis : chartFont.size.label;       // 13 / 14
    const pillSize = compact ? chartFont.size.caption : chartFont.size.small;      // 10.5 / 12
    const badgeSize = compact ? chartFont.size.value : chartFont.size.metric;      // 18 / 26
    const textWrapper = createSvgTextWrapper(svg);
    const layerWidth = (index) => Math.max(120, maxW - index * stackInset * 2);
    const groupText = (group) => `${payload.stackLabels[group.key]}: ${group.entries.map((lines) => lines.join(' — ')).join('; ')}`;
    const detailLines = (layer) => [...layer.fullDetails.notes, ...layer.fullDetails.groups.map(groupText)];
    svg.append('text')
      .attr('x', margin.left)
      .attr('y', margin.top - 24)
      .attr('fill', palette.muted)
      .attr('font-size', chartFont.small)
      .attr('font-weight', fontWeight('label'))
      .attr('letter-spacing', chartFont.tracking.subtle)
      .text(payload.stackLabels.overview);
    const groups = svg.append('g').selectAll('g.stack-layer').data(layers).join('g')
      .attr('class', 'stack-layer')
      .attr('transform', (_d, index) => {
        const inset = index * stackInset;
        const xOffset = margin.left + inset;
        const yOffset = margin.top + index * (layerH + layerGap);
        return `translate(${xOffset},${yOffset})`;
      });
    groups.append('rect')
      .attr('class', 'stack-layer-lip')
      .attr('x', compact ? 8 : 12)
      .attr('y', layerH - 8)
      .attr('width', (_d, index) => Math.max(100, maxW - index * stackInset * 2 - (compact ? 16 : 24)))
      .attr('height', 20)
      .attr('rx', 9)
      .attr('fill', (d) => colorForTone(d.tone))
      .attr('opacity', 0.24);
    groups.append('rect')
      .attr('class', 'stack-layer-card')
      .attr('width', (_d, index) => Math.max(120, maxW - index * stackInset * 2))
      .attr('height', layerH)
      .attr('rx', 18)
      .attr('fill', (_d, index) => d3.interpolateRgb('#fffaf5', '#efe0d6')(index / Math.max(1, layers.length - 1)))
      .attr('stroke', (d) => colorForTone(d.tone))
      .attr('stroke-width', 2);
    groups.append('text')
      .attr('x', 24)
      .attr('y', compact ? 28 : 32)
      .attr('fill', palette.ink)
      .attr('font-size', titleSize)
      .attr('font-weight', fontWeight('emphasis'))
      .text((d, index) => textWrapper.fit(d.label, { fontSize: titleSize, fontWeight: fontWeight('emphasis'), maxWidth: layerWidth(index) - 42 - badgeSize * 2 }));
    groups.append('text')
      .attr('x', 24)
      .attr('y', compact ? 50 : 56)
      .attr('fill', palette.muted)
      .attr('font-size', detailSize)
      .attr('font-weight', fontWeight('medium'))
      .text((d, index) => textWrapper.fit(d.detail, { fontSize: detailSize, fontWeight: fontWeight('medium'), maxWidth: layerWidth(index) - 48 }));
    groups.append('text')
      .attr('x', (d, index) => Math.max(104, maxW - index * stackInset * 2 - 18))
      .attr('y', compact ? 32 : 38)
      .attr('text-anchor', 'end')
      .attr('fill', palette.claret)
      .attr('font-size', badgeSize)
      .attr('font-weight', fontWeight('emphasis'))
      .text((_d, index) => `L${index + 1}`);
    const moduleRows = groups.append('g').attr('class', 'stack-modules').attr('transform', `translate(24,${compact ? 64 : 72})`);
    moduleRows.each(function(d, layerIndex) {
      const layerWidth = Math.max(120, maxW - layerIndex * stackInset * 2);
      const modules = (d.fullDetails.groups.find((group) => group.key === 'modules')?.entries ?? [])
        .slice(0, compact ? 1 : 2).map((lines) => ({ label: lines.join(' — '), kind: 'module' }));
      const output = d.fullDetails.groups.find((group) => group.key === 'outputs')?.entries[0];
      const pills = [...modules, ...(output ? [{ label: `→ ${output.join(' — ')}`, kind: 'output' }] : [])];
      let xCursor = 0;
      const row = d3.select(this);
      pills.forEach((pill) => {
        const pillW = Math.min(compact ? 110 : 150, Math.max(60, pill.label.length * 8 + 22));
        const text = textWrapper.fit(pill.label, { fontSize: pillSize, fontWeight: fontWeight('strong'), maxWidth: pillW - 22 });
        if (xCursor + pillW > layerWidth - 54) return;
        const isOutput = pill.kind === 'output';
        const pillGroup = row.append('g').attr('transform', `translate(${xCursor},0)`);
        pillGroup.append('rect')
          .attr('width', pillW)
          .attr('height', compact ? 20 : 22)
          .attr('rx', compact ? 10 : 11)
          .attr('fill', isOutput ? 'rgba(153,15,61,0.08)' : 'rgba(255,250,245,0.78)')
          .attr('stroke', isOutput ? 'rgba(153,15,61,0.22)' : 'rgba(212,196,184,0.72)');
        pillGroup.append('text')
          .attr('x', pillW / 2)
          .attr('y', compact ? 14 : 15)
          .attr('text-anchor', 'middle')
          .attr('fill', isOutput ? palette.claret : palette.ink)
          .attr('font-size', pillSize)
          .attr('font-weight', fontWeight('strong'))
          .text(text);
        xCursor += pillW + 8;
      });
    });
    groups.each(function(d) {
      addTitle(d3.select(this), [d.label, ...detailLines(d)].join('; '));
    });
    withTooltip(groups, (d) => tooltipHtml(d.label, detailLines(d)));
    textWrapper.remove();
  };

  const renderPyramid = (element, payload) => {
    const items = normalizedItems(payload.data, payload.itemLabel);
    const containerWidth = Math.floor(element.getBoundingClientRect().width || 760);
    const { svg, width } = svgBase(element, 300);
    const textWrapper = createSvgTextWrapper(svg);
    const margin = { top: 28, right: 34, bottom: 34, left: 34 };
    const maxW = width - margin.left - margin.right;
    const padX = 22;
    const labelLineH = 22;
    const detailLineH = 16;
    const padTop = 12;
    const padBottom = 12;
    const gapBetweenLabelDetail = 8;
    const gapBetweenLayers = 10;
    const labelFont = chartFont.size.large;
    const detailFont = chartFont.small;
    const widthStep = Math.min(0.1, 0.5 / Math.max(1, items.length - 1));
    const layout = items.map((item, index) => {
      const w = maxW * (1 - index * widthStep);
      const labelLines = textWrapper.wrap(item.label, { fontSize: labelFont, fontWeight: fontWeight('emphasis'), maxWidth: w - padX * 2 });
      const details = [...new Set([fullValueLabel(item), ...figureValueNotes(item)]
        .map(safeText).filter((text) => text && text !== safeText(item.label)))];
      const detailLines = details.flatMap((detail) => textWrapper.wrap(detail, { fontSize: detailFont, fontWeight: fontWeight('medium'), maxWidth: w - padX * 2 }));
      const cardH = Math.max(
        66,
        padTop + labelLines.length * labelLineH + (detailLines.length ? gapBetweenLabelDetail + detailLines.length * detailLineH : 0) + padBottom,
      );
      return { item, index, w, labelLines, details, detailLines, cardH };
    });
    textWrapper.remove();
    let cursorY = margin.top;
    for (const entry of layout) { entry.y = cursorY; cursorY += entry.cardH + gapBetweenLayers; }
    const svgHeight = Math.max(300, cursorY - gapBetweenLayers + margin.bottom);
    svg.attr('viewBox', `0 0 ${width} ${svgHeight}`).attr('height', Math.ceil(svgHeight * Math.min(1, containerWidth / width)));
    const groups = svg.append('g').selectAll('g').data(layout).join('g').attr('transform', (entry) => `translate(${(width - entry.w) / 2},${entry.y})`);
    groups.append('rect').attr('width', (entry) => entry.w).attr('height', (entry) => entry.cardH).attr('rx', 14).attr('fill', (_entry, index) => d3.interpolateRgb('#fff7ef', '#ead8cf')(index / Math.max(1, layout.length - 1))).attr('stroke', (entry) => colorForTone(entry.item.tone)).attr('stroke-width', 1.7);
    groups.append('text')
      .attr('x', padX)
      .attr('y', padTop + labelFont)
      .attr('fill', palette.claret)
      .attr('font-size', labelFont)
      .attr('font-weight', fontWeight('emphasis'))
      .each(function(entry) { renderLineBlock(d3.select(this), entry.labelLines, { x: padX, y: padTop + labelFont, lineHeight: labelLineH }); });
    groups.filter((entry) => entry.detailLines.length > 0).append('text')
      .attr('x', padX)
      .attr('fill', palette.ink)
      .attr('font-size', detailFont)
      .attr('font-weight', fontWeight('medium'))
      .each(function(entry) {
        const startY = padTop + entry.labelLines.length * labelLineH + gapBetweenLabelDetail + detailFont;
        renderLineBlock(d3.select(this), entry.detailLines, { x: padX, y: startY, lineHeight: detailLineH });
      });
    groups.each(function(entry) { addTitle(d3.select(this), [entry.item.label, ...entry.details].join(' — ')); });
    withTooltip(groups, (entry) => tooltipHtml(entry.item.label, entry.details));
    const printLayers = d3.select(element).append('ol').attr('class', 'pyramid-print-layers');
    const printRows = printLayers.selectAll('li').data(layout).join('li')
      .style('border-left-color', (entry) => colorForTone(entry.item.tone));
    printRows.append('strong').text((entry) => entry.item.label);
    printRows.selectAll('p').data((entry) => entry.details).join('p').text((detail) => detail);
  };

  const renderJourneyMap = (element, payload) => {
    const items = normalizedItems(payload.data, payload.itemLabel).map(item => ({
      ...item, notes: [...new Set([...figureValueNotes(item),
        ...['actor', 'actors', 'phase', 'stage', 'emotion', 'channel', 'channels', 'touchpoints']
          .flatMap(key => arr(item[key]).length ? item[key] : [item[key]])
          .filter(value => typeof value === 'string' && value.trim()),
      ])],
    }));
    const { svg, width } = svgBase(element, 360, Math.max(320, 188 + (items.length - 1) * 88));
    const wrapper = createSvgTextWrapper(svg);
    const layout = items.map((item, index) => {
      const title = wrapper.wrap(item.label, { fontSize: 12, fontWeight: 800, maxWidth: 120 });
      return { ...item, index, title, height: Math.max(52, 20 + title.length * 15) };
    });
    const height = Math.max(360, 2 * Math.max(...layout.map(item => item.height)) + 184);
    const x = d3.scalePoint().domain(layout.map(item => item.index)).range([72, width - 72]).padding(0.25);
    layout.forEach(item => { item.x = x(item.index); item.y = height / 2 + (item.index % 2 ? 28 : -28); });
    svg.attr('viewBox', `0 0 ${width} ${height}`);
    scrollableSvg(element, svg, width, height, payload);
    svg.append('path').datum(layout).attr('class', 'journey-connector')
      .attr('d', d3.line().curve(d3.curveCatmullRom.alpha(0.6)).x(item => item.x).y(item => item.y))
      .attr('fill', 'none').attr('stroke', palette.claret).attr('stroke-width', 3).attr('opacity', 0.8);
    const cards = svg.append('g').selectAll('g').data(layout).join('g').attr('class', 'journey-card')
      .attr('transform', item => `translate(${item.x},${item.y})`);
    cards.append('circle').attr('r', 18).attr('fill', item => colorForTone(item.tone)).attr('stroke', palette.paper).attr('stroke-width', 3);
    cards.append('text').attr('class', 'journey-number').attr('y', 4).attr('text-anchor', 'middle')
      .attr('fill', palette.paper).attr('font-size', 12).attr('font-weight', 800).text(item => item.index + 1);
    cards.append('rect').attr('x', -72).attr('y', item => item.index % 2 ? 34 : -40 - item.height)
      .attr('width', 144).attr('height', item => item.height).attr('rx', 9).attr('fill', palette.paper).attr('stroke', palette.border);
    cards.append('text').attr('class', 'journey-stage-label').attr('text-anchor', 'middle')
      .attr('fill', palette.ink).attr('font-size', 12).attr('font-weight', 800)
      .each(function(item) {
        renderLineBlock(d3.select(this), item.title, {
          x: 0, y: (item.index % 2 ? 34 : -40 - item.height) + 19, lineHeight: 15,
        });
      });
    withTooltip(cards, item => tooltipHtml(item.label, item.notes));
    const print = d3.select(element).append('ol').attr('class', 'journey-print-events');
    const rows = print.selectAll('li').data(items).join('li');
    rows.append('strong').text(item => item.label);
    rows.selectAll('p').data(item => item.notes).join('p').text(note => note);
    wrapper.remove();
  };

  const renderKpi = (element, payload) => {
    const items = normalizedItems({ items: payload.data.items ?? payload.data.nodes }, payload.itemLabel);
    d3.select(element).selectAll('*').remove();
    const grid = d3.select(element).append('div').attr('class', 'kpi-grid');
    const cards = grid.selectAll('div.kpi-card').data(items).join('div')
      .attr('class', (d) => `kpi-card kpi-tone-${d.tone || 'neutral'}`);
    const labelRow = cards.append('div').attr('class', 'kpi-card-label');
    labelRow.append('span').attr('class', 'kpi-card-dot').attr('aria-hidden', 'true');
    labelRow.append('span').attr('class', 'kpi-card-label-text').text((d) => d.label);
    cards.append('div').attr('class', 'kpi-card-value').text((d) => String(fullValueLabel(d) ?? ''));
    cards.selectAll('div.kpi-card-detail').data(figureValueNotes).join('div')
      .attr('class', 'kpi-card-detail').text((note) => note);
