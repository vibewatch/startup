---
import ClaimRefs from './ClaimRefs.astro';
import DataTable from './DataTable.astro';
import { RENDERED_FIGURE_TYPES, barSeries, figureItemNotes, figureUnitsDiffer, figureValueNotes, flowRelationshipTable, flowTopology, formatRangeValue, quadrantAxes, stackLayerDetails, waterfallSpans, waterfallValueTable } from '../lib/figures.mjs';
import { t } from '../lib/i18n';
import type { Locale } from '../lib/locale';
import { asArray, asRecord, claimRefs, type Claim, type ReportFigure, type Source } from '../lib/report-types';

interface Props {
  figure: ReportFigure;
  claims?: Claim[];
  sources?: Source[];
  locale?: Locale;
}

const { figure, claims = [], sources = [], locale = 'en' } = Astro.props;
const authoredType = figure?.type ?? 'flow';
const data = figure?.data ?? {};
const flow = authoredType === 'flow' ? figure._flowTopology ?? flowTopology(data) : null;
const relationshipDiagram = flow && !flow.sequence;
const dagTopology = authoredType === 'dag' ? figure._flowTopology ?? flowTopology(data) : relationshipDiagram ? flow : null;
const dagDetails = dagTopology ? flowRelationshipTable(data, dagTopology, {
  nodeLabel: t('reportFigureNode', locale), connectionLabel: t('reportFigureConnection', locale),
  sourceLabel: t('reportFigureNodeOrFrom', locale), targetLabel: t('reportFigureTo', locale),
  contextLabel: t('reportFigureContext', locale),
}) : null;
const coordinateAxes = authoredType === 'quadrant' ? quadrantAxes(figure) : null;
const coordinateDefinitions = coordinateAxes ? Object.entries(coordinateAxes).map(([key, axis]) => ({
  key, label: axis.label, definitions: axis.definitions.filter((definition) => !/^(?:min|max): /.test(definition)),
})).filter((axis) => axis.definitions.length) : [];
const sequenceDetails = flow?.sequence ? flowRelationshipTable(data, flow, {
  nodeLabel: t('reportFigureNode', locale), connectionLabel: t('reportFigureConnection', locale),
  sourceLabel: t('reportFigureNodeOrFrom', locale), targetLabel: t('reportFigureTo', locale),
  contextLabel: t('reportFigureContext', locale),
}) : null;
const funnel = authoredType === 'funnel';
const waterfall = authoredType === 'waterfall';
const waterfallLayout = waterfall ? figure._waterfallSpans ?? waterfallSpans(figure) : null;
const series = authoredType === 'bar' ? barSeries(data) : [];
const stages = series.length === 1
  ? series[0].points.map((item) => item.unit == null && series[0].unit != null ? { ...item, unit: series[0].unit } : item)
  : [];
const unitsDiffer = figureUnitsDiffer(stages);
const type = relationshipDiagram ? 'dag' : authoredType;
const valueDetails = waterfall ? waterfallValueTable(data, {
  valueLabel: t('reportFigureValue', locale), contextLabel: t('reportFigureContext', locale),
  metadataLabel: t('reportWaterfallMetadata', locale),
}) : null;
const chartData = authoredType === 'bar' && series.length === 1 ? { ...data, items: stages } : data;
const chartTypes = new Set(RENDERED_FIGURE_TYPES);
const usesD3Chart = chartTypes.has(type);
const itemLabel = t('reportFigureItem', locale);
const stackDetails = authoredType === 'stack' ? stackLayerDetails(data) : [];
const evidenceItems = authoredType === 'flow' || authoredType === 'dag' ? [[...asArray(data.nodes), ...asArray(data.edges)]]
  : authoredType === 'quadrant' ? [data.points]
  : authoredType === 'waterfall' ? [data.items]
  : authoredType === 'pyramid' ? [data.items, data.nodes]
  : authoredType === 'timeline'
    ? [data.items, data.nodes, data.layers, asRecord(asArray(data.series)[0]).points, data.points]
    : [];
const itemEvidence = (evidenceItems.map((items) => asArray(items)).find((items) => items.length) ?? [])
  .map((item, index) => {
    const entry = asRecord(item);
    const label = authoredType === 'waterfall' ? entry.label ?? entry.name ?? `#${index + 1}`
      : entry.label ?? entry.name ?? entry.id ?? `${itemLabel} ${index + 1}`;
    return { label: String(label), refs: claimRefs(item) };
  }).filter((item) => item.refs.length);
const evidenceClass = authoredType === 'timeline' ? 'timeline-event'
  : authoredType === 'waterfall' ? 'waterfall-value'
  : authoredType === 'pyramid' ? 'pyramid-layer' : 'figure-item';
const stackLabels: Record<string, string> = {
  overview: t('reportStackOverview', locale),
  items: t('reportStackItems', locale),
  modules: t('reportStackModules', locale),
  outputs: t('reportStackOutputs', locale),
};
const rangeLabels = {
  low: t('reportRangeLow', locale),
  mid: t('reportRangeMid', locale),
  high: t('reportRangeHigh', locale),
  midInline: t('reportRangeMidInline', locale),
};
const dagLabels = {
  dependency: relationshipDiagram ? t('reportFigureConnection', locale) : t('reportDagDependency', locale),
  input: t('reportDagInput', locale),
  impact: t('reportDagImpact', locale),
  core: t('reportDagCore', locale),
};
const chartId = `chart-${String(figure?.id ?? 'figure').replace(/[^a-z0-9_-]/gi, '-')}-${Math.random().toString(36).slice(2, 9)}`;
const chartPayload = usesD3Chart ? {
  id: chartId, type, data: chartData, itemLabel, locale, authoredType, scrollLabel: t('reportFigureScrollHint', locale),
  ...(flow ? { flowTopology: flow } : {}),
  ...(authoredType === 'stack' ? { stackLabels } : {}),
  ...(authoredType === 'range' ? { rangeLabels } : {}),
  ...(dagTopology ? { dagLabels } : {}),
  ...(dagTopology ? { dagTopology } : {}),
  ...(coordinateAxes ? { quadrantAxes: coordinateAxes } : {}),
  ...(waterfallLayout ? { waterfallLayout, waterfallLabels: {
    independent: t('reportWaterfallIndependent', locale),
    bridge: t('reportWaterfallBridge', locale), total: t('reportWaterfallTotal', locale),
    increase: t('reportWaterfallIncrease', locale), decrease: t('reportWaterfallDecrease', locale),
    unchanged: t('reportWaterfallUnchanged', locale),
    value: t('reportFigureValue', locale), context: t('reportFigureContext', locale),
    metadata: t('reportWaterfallMetadata', locale),
  } } : {}),
} : null;
const chartPayloadJson = chartPayload
  ? JSON.stringify(chartPayload).replace(/[<>&\u2028\u2029]/g, (char) => ({ '<': '\\u003c', '>': '\\u003e', '&': '\\u0026', '\u2028': '\\u2028', '\u2029': '\\u2029' }[char] ?? char))
  : null;
---

<figure class:list={['native-figure', `figure-${type}`]}>
  <figcaption>{figure.id}: {figure.title}</figcaption>

  {figure.summary && <p class="figure-summary">{figure.summary}</p>}
  {typeof figure.description === 'string' && figure.description !== figure.summary && <p class="figure-summary">{figure.description}</p>}

  {flow?.unresolved && <p class="figure-note flow-endpoint-notice" role="note">{t('reportFlowEndpointNotice', locale)}</p>}
  {dagTopology?.unresolved && !flow && <p class="figure-note dag-endpoint-notice" role="note">{t('reportFlowEndpointNotice', locale)}</p>}
  {funnel && <p class="figure-note funnel-comparison-notice" role="note">{t('reportFunnelComparisonNotice', locale)}</p>}
  {authoredType === 'pyramid' && <p class="figure-note pyramid-layout-notice" role="note">{t('reportPyramidLayoutNotice', locale)}</p>}
  {unitsDiffer && <p class="figure-note bar-unit-notice" role="note">
    {t('reportBarUnitNotice', locale)}
  </p>}

  {usesD3Chart && <div id={chartId} class:list={['d3-figure', `chart-${type}`]}
    role="group" aria-label={figure.title}
    data-loading-label={t('reportFigureLoading', locale)}
    data-error-label={t('reportFigureRenderError', locale)}></div>}

  {coordinateDefinitions.length > 0 && (
    <div class="figure-note figure-item-notes quadrant-axis-definitions">
      <dl>
        {coordinateDefinitions.map((axis) => (
          <div>
            <dt>{axis.key.toUpperCase()}: {axis.label}</dt>
            {axis.definitions.map((definition) => <dd>{definition}</dd>)}
          </div>
        ))}
      </dl>
    </div>
  )}

  {stackDetails.length > 0 && (
    <div class="figure-note figure-item-notes stack-layer-notes">
      <dl>
        {stackDetails.map((layer) => (
          <div>
            <dt>{layer.label}</dt>
            {layer.notes.map((note) => <dd>{note}</dd>)}
            {layer.groups.map((group) => (
              <dd>
                <strong>{stackLabels[group.key]}</strong>
                <ul>{group.entries.map((lines) => <li>{lines.join(' — ')}</li>)}</ul>
              </dd>
            ))}
          </div>
        ))}
      </dl>
    </div>
  )}

  {sequenceDetails && (
    <div class="flow-sequence-details figure-print-details">
      <DataTable columns={[`${t('reportFigureNode', locale)} / ${t('reportFigureConnection', locale)}`, ...sequenceDetails.columns]}>
        {sequenceDetails.rows.map((row) => (
          <tr>
            <td>{row.label}</td>
            {row.values.map((value) => <td>{value && typeof value === 'object' ? value.label : value}</td>)}
          </tr>
        ))}
      </DataTable>
    </div>
  )}

  {dagDetails && (
    <div class="dag-details figure-print-details">
      <DataTable columns={[`${t('reportFigureNode', locale)} / ${t('reportFigureConnection', locale)}`, ...dagDetails.columns]}>
        {dagDetails.rows.map((row) => (
          <tr>
            <td>{row.label}</td>
            {row.values.map((value) => <td>{value && typeof value === 'object' ? value.label : value}</td>)}
          </tr>
        ))}
      </DataTable>
    </div>
  )}

  {coordinateAxes && (
    <div class="quadrant-details figure-print-details">
      <DataTable columns={[t('reportFigureItem', locale),
        `${coordinateAxes.x.label || 'X'} (${coordinateAxes.x.domain.map(formatRangeValue).join('–')})`,
        `${coordinateAxes.y.label || 'Y'} (${coordinateAxes.y.domain.map(formatRangeValue).join('–')})`,
        t('reportFigureContext', locale)]}>
        {asArray(data.points).map((item, index) => {
          const point = asRecord(item);
          return <tr>
            <td>{index + 1}. {point.label}</td>
            <td>{formatRangeValue(point.x)}</td>
            <td>{formatRangeValue(point.y)}</td>
            <td>{figureValueNotes(point).join('\n')}</td>
          </tr>;
        })}
      </DataTable>
    </div>
  )}

  {valueDetails && (
    <div class="figure-value-details figure-print-details">
      <DataTable columns={[t('reportFigureItem', locale), ...valueDetails.columns]}>
        {valueDetails.rows.map((row) => (
          <tr>
            <td>{row.label}</td>
            {row.values.map((value) => <td>
              {value && typeof value === 'object' ? value.label : value}
              {value && typeof value === 'object' && value.detail && <small>{value.detail}</small>}
            </td>)}
          </tr>
        ))}
      </DataTable>
    </div>
  )}

  {type === 'other' && (
    <div class="figure-fallback" role="note">
      <strong>{t('reportFigureGenericTitle', locale)}</strong>
      <p>{t('reportFigureGenericDescription', locale)}</p>
    </div>
  )}

  {figure.approximationNotes && <p class="figure-note">{figure.approximationNotes}</p>}
  {itemEvidence.length > 0 && (
    <div class={`${evidenceClass}-evidence`}>
      {itemEvidence.map((item) => (
        <p class={`claim-ref ${evidenceClass}-reference`}>
          <span>{item.label}</span>
          <ClaimRefs refs={item.refs} claims={claims} sources={sources} />
        </p>
      ))}
    </div>
  )}
  <ClaimRefs refs={claimRefs(figure)} claims={claims} sources={sources} />
  {chartPayloadJson && <script type="application/json" class="figure-chart-data" set:html={chartPayloadJson}></script>}
</figure>

<script>
  import * as d3 from 'd3';
  import { displayCellText } from '../lib/display';
  import { barSeries, chartNumericValue, figureDetail, figureItemNotes, figureUnitsDiffer, figureValueNotes, flowTopology, formatRangeValue, graphItemNotes, matrixCellText, quadrantLabelPositions, rangeAxisTickIndices, rangeCenterValue, stackLayerDetails, waterfallValueTable } from '../lib/figures.mjs';

  const palette = {
    claret: '#990f3d',
    ink: '#33302e',
    muted: '#6b625c',
    border: '#d8ccc2',
    paper: '#fff7ef',
    positive: '#0f766e',
    risk: '#b42318',
    opportunity: '#b8860b',
    neutral: '#990f3d',
  };

  const arr = (value) => Array.isArray(value) ? value : [];
  const colorForTone = (tone) => {
    if (tone === 'positive' || tone === 'low') return palette.positive;
    if (tone === 'risk' || tone === 'critical' || tone === 'high' || tone === 'negative' || tone === 'adverse') return palette.risk;
    if (tone === 'opportunity' || tone === 'warning' || tone === 'medium') return palette.opportunity;
    return palette.neutral;
  };
  const riskValue = (tone) => {
    if (tone === 'high' || tone === 'critical' || tone === 'risk' || tone === 'negative' || tone === 'adverse') return 3;
    if (tone === 'medium' || tone === 'warning' || tone === 'neutral') return 2;
    return 1;
  };
  const labelText = (text, max = 24) => String(text ?? '').length > max ? `${String(text).slice(0, max - 1)}…` : String(text ?? '');
  const numberValue = (value) => Number(value) || 0;
  const valueLabel = (item) => item?.displayValue ?? item?.value ?? '';
  const fullValueLabel = (item) => item?.displayValue ?? item?.value ?? item?.score ?? item?.label ?? '';
  // Safely render cell-like values (string, number, or object) as text.
  // Object cells use canonical display fields (`label`, `displayValue`,
  // `value`, `score`); blindly stringifying an object produces
  // "[object Object]". Always route cell text through this helper.
  const safeText = (value) => {
    if (value == null) return '';
    if (typeof value === 'string' || typeof value === 'number') return String(value);
    if (typeof value === 'object') {
      const text = value.label ?? value.displayValue ?? value.value;
      if (text != null && String(text).trim() !== '') return String(text);
      if (value.score != null) return String(value.score);
      return '';
    }
    return String(value);
  };

  const chartFont = {
    family: 'var(--font-sans, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif)',
    size: {
      micro: 8,
      tiny: 9.5,
      caption: 10.5,
      small: 12,
      axis: 13,
      label: 14,
      title: 16,
      value: 18,
      large: 20,
      arrow: 24,
      metric: 26,
    },
    weight: {
      regular: 650,
      body: 700,
      medium: 750,
      strong: 800,
      label: 900,
      emphasis: 950,
    },
    tracking: {
      subtle: '0em',
      caps: '0em',
    },
    lineHeight: {
      compact: 12,
      tight: 13,
      small: 15,
      label: 16,
      title: 18,
    },
    cssVar: {
      kicker: 'var(--chart-fs-kicker)',
      caption: 'var(--chart-fs-caption)',
      body: 'var(--chart-fs-body)',
      note: 'var(--chart-fs-note)',
    },
  };
  chartFont.axis = chartFont.size.axis;
  chartFont.label = chartFont.size.label;
  chartFont.small = chartFont.size.small;
  const fontSize = (name) => chartFont.size[name] ?? name;
  const fontWeight = (name) => chartFont.weight[name] ?? name;
  const tooltip = (() => {
    const node = d3.select('body').selectAll('.d3-chart-tooltip').data([null]).join('div').attr('class', 'd3-chart-tooltip').attr('role', 'tooltip');
    const move = (event) => {
      const gap = window.innerWidth < 520 ? 10 : 14;
      const pad = window.innerWidth < 520 ? 10 : 14;
      const tooltipNode = node.node();
      const box = tooltipNode?.getBoundingClientRect?.() ?? { width: 0, height: 0 };
      const spaceRight = window.innerWidth - event.clientX;
      const spaceBottom = window.innerHeight - event.clientY;
      const placeLeft = spaceRight < box.width + gap + pad && event.clientX > box.width + gap + pad;
      const placeTop = spaceBottom < box.height + gap + pad && event.clientY > box.height + gap + pad;
      const rawLeft = placeLeft ? event.clientX - box.width - gap : event.clientX + gap;
      const rawTop = placeTop ? event.clientY - box.height - gap : event.clientY + gap;
      const left = Math.max(pad, Math.min(window.innerWidth - box.width - pad, rawLeft));
      const top = Math.max(pad, Math.min(window.innerHeight - box.height - pad, rawTop));
      const pointerX = Math.max(18, Math.min(box.width - 18, event.clientX - left));
      const tooltipFont = window.innerWidth < 520 ? chartFont.size.small : window.innerWidth < 760 ? chartFont.axis : 13.8;
      node
        .attr('data-placement-x', placeLeft ? 'left' : 'right')
        .attr('data-placement-y', placeTop ? 'top' : 'bottom')
        .style('left', `${left}px`)
        .style('top', `${top}px`)
        .style('--tooltip-pointer-x', `${pointerX}px`)
        .style('--tooltip-font', `${tooltipFont}px`);
    };
    return {
      show(event, html) {
        node.html(html).classed('is-visible', true);
        move(event);
      },
      move,
      hide() {
        node.classed('is-visible', false);
      },
    };
  })();
  const escapeHtml = (value) => String(value ?? '').replace(/[&<>"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[char]));
  const tooltipHtml = (title, lines = []) => `<strong>${escapeHtml(title)}</strong>${lines.filter(Boolean).map((line) => `<span>${escapeHtml(line)}</span>`).join('')}`;
  const shouldShowTooltip = () => true;
  document.addEventListener('pointerdown', (event) => {
    if (event.target?.closest?.('.d3-figure')) return;
    tooltip.hide();
  });
  const withTooltip = (selection, htmlForDatum) => selection
    .style('cursor', 'default')
    .on('pointerenter', function(event, datum) {
      d3.select(this).classed('is-hovered', true);
      if (!shouldShowTooltip()) return;
      const html = typeof htmlForDatum === 'function' ? htmlForDatum(datum) : htmlForDatum;
      tooltip.show(event, html);
    })
    .on('pointerdown', function(event, datum) {
      event.stopPropagation();
      d3.select(this).classed('is-hovered', true);
      const html = typeof htmlForDatum === 'function' ? htmlForDatum(datum) : htmlForDatum;
      tooltip.show(event, html);
    })
    .on('pointermove', (event) => {
      if (shouldShowTooltip()) tooltip.move(event);
    })
    .on('pointerleave', function(event) {
      d3.select(this).classed('is-hovered', false);
      if (event.pointerType !== 'touch') tooltip.hide();
    })
    .on('pointercancel', function() {
      d3.select(this).classed('is-hovered', false);
      tooltip.hide();
    });
  const wrapWords = (text, maxChars = 18, maxLines = 2) => {
    const chunkSize = Math.max(4, Math.floor(maxChars));
    const splitLongWord = (word) => {
      const chars = Array.from(String(word ?? ''));
      if (chars.length <= chunkSize) return [word];
      const chunks = [];
      for (let index = 0; index < chars.length; index += chunkSize) chunks.push(chars.slice(index, index + chunkSize).join(''));
      return chunks;
    };
    const words = String(text ?? '').split(/\s+/).filter(Boolean).flatMap(splitLongWord);
    if (!words.length) return [''];
    const lines = [];
    let line = '';
    words.forEach((word) => {
      const next = line ? `${line} ${word}` : word;
      if (next.length > maxChars && line) {
        lines.push(line);
        line = word;
      } else {
        line = next;
      }
    });
    if (line) lines.push(line);
    const clipped = lines.slice(0, maxLines);
    if (lines.length > maxLines) clipped[clipped.length - 1] = labelText(clipped[clipped.length - 1], Math.max(4, maxChars - 1));
    return clipped;
  };
  const renderWrappedText = (selection, text, { maxChars = 18, maxLines = 2, lineHeight = chartFont.lineHeight.small, dy = 0, textWrapper, maxWidth } = {}) => {
    const x = selection.attr('x') ?? 0;
    selection.text(null);
    const lines = textWrapper
      ? textWrapper.wrap(text, { fontSize: selection.attr('font-size'), fontWeight: selection.attr('font-weight'), maxWidth, maxLines })
      : wrapWords(text, maxChars, maxLines);
    const offset = dy - ((lines.length - 1) * lineHeight) / 2;
    lines.forEach((line, index) => {
      selection.append('tspan').attr('x', x).attr('dy', index === 0 ? offset : lineHeight).text(line);
    });
  };
  const renderLineBlock = (selection, lines, { x = 0, y = 0, lineHeight = chartFont.lineHeight.small } = {}) => {
    selection.text(null).attr('x', x).attr('y', y);
    lines.forEach((line, index) => {
      selection.append('tspan').attr('x', x).attr('dy', index === 0 ? 0 : lineHeight).text(line);
    });
  };
  const svgBase = (element, height = 340, minWidthOverride = null) => {
    const containerWidth = Math.floor(element.getBoundingClientRect().width || 760);
    const width = Math.max(containerWidth, minWidthOverride ?? 0);
    const displayHeight = Math.ceil(height * Math.min(1, containerWidth / width));
    d3.select(element).selectAll('*').remove();
    const svg = d3.select(element)
      .append('svg')
      .attr('viewBox', `0 0 ${width} ${height}`)
      .attr('role', 'img')
      .attr('width', '100%')
      .attr('height', displayHeight)
      .style('font-family', chartFont.family)
      .style('display', 'block');
    return { svg, width, height };
  };
  const addTitle = (selection, text) => selection.attr('aria-label', String(text ?? ''));
  const scrollableSvg = (element, svg, width, height, payload) => {
    const frame = d3.select(element).append('div').attr('class', 'chart-scroll-frame')
      .attr('role', 'region').attr('tabindex', 0).attr('aria-label', element.getAttribute('aria-label'));
    svg.attr('width', width).attr('height', height).style('width', `${width}px`).style('max-width', 'none');
    frame.node().appendChild(svg.node());
    if (width > element.getBoundingClientRect().width) {
      frame.attr('aria-describedby', `${payload.id}-scroll-hint`);
      d3.select(element).append('p').attr('class', 'chart-scroll-hint').attr('id', `${payload.id}-scroll-hint`).text(payload.scrollLabel);
    }
  };
  const axisBottom = (g, scale, y, ticks = 4) => g.append('g')
    .attr('transform', `translate(0,${y})`)
    .call(d3.axisBottom(scale).ticks(ticks).tickSizeOuter(0))
    .call((axis) => axis.select('.domain').attr('stroke', palette.border))
    .call((axis) => axis.selectAll('line').attr('stroke', palette.border))
    .call((axis) => axis.selectAll('text').attr('fill', palette.muted).attr('font-size', chartFont.axis));
  const axisLeft = (g, scale, x) => g.append('g')
    .attr('transform', `translate(${x},0)`)
    .call(d3.axisLeft(scale).tickSizeOuter(0))
    .call((axis) => axis.select('.domain').remove())
    .call((axis) => axis.selectAll('line').remove())
    .call((axis) => axis.selectAll('text').attr('fill', palette.ink).attr('font-size', chartFont.axis).attr('font-weight', fontWeight('body')).each(function(d) {
      const text = d3.select(this);
      renderWrappedText(text, d, { maxChars: 19, maxLines: 2, lineHeight: chartFont.lineHeight.tight });
    }));

  const renderDag = (element, payload) => {
    const nodes = arr(payload.data.nodes).map((node, index) => ({ ...node, notes: graphItemNotes(node), _key: index, _index: index }));
    const edges = arr(payload.data.edges).map((edge, index) => ({
      ...edge, notes: graphItemNotes(edge), _edgeIndex: index,
      from: payload.dagTopology.endpoints[index].fromIndex, to: payload.dagTopology.endpoints[index].toIndex,
    }));
    if (!nodes.length) return;
    const byKey = new Map(nodes.map((node) => [node._key, node]));
    const incoming = d3.group(edges, (edge) => edge.to);
    const outgoing = d3.group(edges, (edge) => edge.from);
    // Cycle-safe topological-ish depth from roots. Some reports label graphs as
    // DAGs while still containing feedback loops (for example support ↔ users).
    // A longest-path relaxation loop never converges on cycles, so use Kahn's
    // algorithm with provisional depths from already-processed predecessors and
    // preserve unresolved cyclic nodes at their best known stage.
    const roots = nodes.filter((node) => !incoming.has(node._key));
    const depthByKey = new Map();
    const indegreeByKey = new Map(nodes.map((node) => [node._key, arr(incoming.get(node._key)).length]));
    const processed = new Set();
    const queue = (roots.length ? roots : [nodes[0]]).filter(Boolean);
    queue.forEach((node) => depthByKey.set(node._key, 0));
    while (queue.length) {
      const current = queue.shift();
      if (!current || processed.has(current._key)) continue;
      processed.add(current._key);
      const currentDepth = depthByKey.get(current._key) ?? 0;
      for (const edge of arr(outgoing.get(current._key))) {
