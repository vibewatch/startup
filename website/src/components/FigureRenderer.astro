  };

  const chartSeries = payload => barSeries(payload.data).map((series, seriesIndex) => ({
    ...series, label: series.label ?? series.name ?? '',
    points: series.points.map((item, index) => ({
      ...item, label: item.label ?? item.name ?? item.id ?? `${payload.itemLabel} ${index + 1}`,
      unit: item.unit ?? series.unit, _seriesIndex: seriesIndex, _pointIndex: index,
    })),
  }));

  const renderBar = (element, payload) => {
    const series = chartSeries(payload);
    if (!series.length) throw new Error('Bar figure has no populated series');
    d3.select(element).selectAll('*').remove();
    const root = d3.select(element).append('div').attr('class', 'bar-panels');
    for (const group of series) {
      const panels = figureUnitsDiffer(group.points) ? group.points.map(point => [point]) : [group.points];
      for (const points of panels) {
        const panel = root.append('section').attr('class', 'bar-panel');
        if (group.label) panel.append('h3').attr('class', 'bar-series-label').text(group.label);
        panel.selectAll('p.bar-series-note').data(figureItemNotes(group)).join('p').attr('class', 'bar-series-note').text(note => note);
        const numeric = points.map(point => chartNumericValue(point.value)).filter(value => value != null);
        const minimum = Math.min(0, ...numeric), maximum = Math.max(0, ...numeric);
        const width = Math.floor(panel.node().getBoundingClientRect().width);
        const svg = panel.append('svg').attr('role', 'img').attr('width', '100%').style('font-family', chartFont.family);
        const wrapper = createSvgTextWrapper(svg);
        const compact = width < 640;
        const left = compact ? Math.min(120, width * 0.36) : Math.min(220, Math.max(152, ...points.map(point => wrapper.measure(point.label, { fontSize: 13, fontWeight: 800 }) + 16)));
        const right = compact ? 76 : 112;
        let cursor = 18;
        const layout = points.map(point => {
          const rawValue = valueLabel(point);
          const value = [rawValue === '' && point.value == null && point.displayValue == null ? '—' : rawValue, point.unit]
            .filter(value => value != null && value !== '').join(' ');
          const title = wrapper.wrap(point.label, { fontSize: 13, fontWeight: 800, maxWidth: left - 16 });
          const valueLines = wrapper.wrap(value, { fontSize: 13, fontWeight: 800, maxWidth: right - 12 });
          const height = Math.max(42, Math.max(title.length, valueLines.length) * 16 + 12);
          const item = { ...point, valueText: value, title, valueLines, top: cursor, height, number: chartNumericValue(point.value) };
          cursor += height;
          return item;
        });
        const height = Math.max(260, cursor + 38);
        const extra = (height - 38 - cursor) / layout.length;
        layout.forEach((point, index) => { point.top += index * extra; point.height += extra; });
        cursor = height - 38;
        svg.attr('viewBox', `0 0 ${width} ${height}`).attr('height', height);
        const x = d3.scaleLinear().domain(minimum === maximum ? [0, 1] : [minimum, maximum]).nice().range([left, width - right]);
        if (numeric.length) axisBottom(svg, x, height - 38, compact ? 2 : 4).attr('class', 'bar-axis');
        svg.append('line').attr('class', 'bar-zero').attr('x1', x(0)).attr('x2', x(0))
          .attr('y1', 18).attr('y2', cursor).attr('stroke', palette.border);
        const rows = svg.append('g').selectAll('g').data(layout).join('g').attr('class', 'bar-row')
          .attr('data-value-state', point => point.number == null ? 'unavailable' : 'numeric');
        rows.append('text').attr('class', 'bar-row-label').attr('text-anchor', 'end')
          .attr('fill', palette.ink).attr('font-size', 13).attr('font-weight', 800)
          .each(function(point) {
            renderLineBlock(d3.select(this), point.title, { x: left - 10, y: point.top + point.height / 2 - (point.title.length - 1) * 8 + 4, lineHeight: 16 });
          });
        rows.filter(point => point.number != null).append('rect').attr('class', 'bar-fill')
          .attr('x', point => x(Math.min(0, point.number))).attr('y', point => point.top + point.height * 0.13)
          .attr('width', point => Math.abs(x(point.number) - x(0))).attr('height', point => point.height * 0.74)
          .attr('rx', 4).attr('fill', point => colorForTone(point.tone));
        rows.filter(point => point.number === 0).append('line').attr('class', 'bar-zero-value')
          .attr('x1', x(0)).attr('x2', x(0)).attr('y1', point => point.top + point.height * 0.13).attr('y2', point => point.top + point.height * 0.87)
          .attr('stroke', palette.claret).attr('stroke-width', 2);
        rows.append('text').attr('class', 'bar-row-value').attr('fill', palette.ink).attr('font-size', 13).attr('font-weight', 800)
          .each(function(point) {
            renderLineBlock(d3.select(this), point.valueLines, {
              x: minimum < 0 || point.number == null ? width - right + 8 : x(point.number) + 8,
              y: point.top + point.height / 2 - (point.valueLines.length - 1) * 8 + 4, lineHeight: 16,
            });
          });
        const notes = panel.append('dl').attr('class', 'bar-source-notes');
        for (const point of points) {
          if (!figureItemNotes(point).length) continue;
          notes.append('dt').text(point.label);
          notes.selectAll(null).data(figureItemNotes(point)).enter().append('dd').text(note => note);
        }
        const print = panel.append('ol').attr('class', 'bar-print-values');
        const printRows = print.selectAll('li').data(layout).join('li');
        printRows.append('strong').text(point => `${point.label}: ${point.valueText}`);
        printRows.selectAll('p').data(figureItemNotes).join('p').text(note => note);
        withTooltip(rows, point => tooltipHtml(point.label, [group.label, point.valueText, ...figureItemNotes(point), ...figureItemNotes(group)]));
        wrapper.remove();
      }
    }
  };

  const renderFunnel = (element, payload) => {
    const series = chartSeries(payload);
    if (!series.length) throw new Error('Funnel figure has no populated stages');
    const { svg, width } = svgBase(element, 300);
    const wrapper = createSvgTextWrapper(svg);
    const compact = width < 640;
    const left = compact ? 16 : 142, right = compact ? 16 : 112;
    const maxWidth = width - left - right;
    const colors = ['#a81749', '#b42351', '#c2415a', '#d1942f', '#0f766e'];
    let cursor = 24;
    const stages = [];
    for (const group of series) {
      if (group.label) {
        const lines = wrapper.wrap(group.label, { fontSize: 14, fontWeight: 900, maxWidth });
        const heading = svg.append('text').attr('fill', palette.ink).attr('font-size', 14).attr('font-weight', 900);
        renderLineBlock(heading, lines, { x: 18, y: cursor + 14, lineHeight: 18 });
        cursor += lines.length * 18 + 18;
      }
      group.points.forEach((item, index) => {
        const w = maxWidth * (1 - 0.65 * index / Math.max(1, group.points.length - 1));
        const title = wrapper.wrap(item.label, { fontSize: 12, fontWeight: 800, maxWidth: compact ? maxWidth : left - 26 });
        const value = [valueLabel(item), item.unit].filter(value => value != null && value !== '').join(' ');
        const valueLines = wrapper.wrap(value, { fontSize: 12, fontWeight: 800, maxWidth: compact ? maxWidth : right - 20 });
        const notes = [...new Set([...figureItemNotes(group), ...figureItemNotes(item)])];
        const h = compact ? 56 + (title.length + valueLines.length) * 16 : Math.max(52, Math.max(title.length, valueLines.length) * 16 + 8);
        stages.push({ item, group: group.label, index, notes, value, title, valueLines, y: cursor, w, h });
        cursor += h + 8;
      });
      cursor += 16;
    }
    svg.attr('viewBox', `0 0 ${width} ${cursor}`).attr('height', cursor);
    const rows = svg.append('g').selectAll('g').data(stages).join('g').attr('class', 'funnel-stage')
      .attr('transform', stage => `translate(0,${stage.y})`);
    const barY = stage => compact ? stage.title.length * 16 + 8 : (stage.h - 44) / 2;
    rows.append('rect').attr('class', 'funnel-track').attr('x', left).attr('y', barY)
      .attr('width', maxWidth).attr('height', 44).attr('rx', 12).attr('fill', '#f9f1eb').attr('stroke', '#eadfd5');
    rows.append('rect').attr('class', 'funnel-band').attr('x', stage => left + (maxWidth - stage.w) / 2).attr('y', barY)
      .attr('width', stage => stage.w).attr('height', 44).attr('rx', 12)
      .attr('fill', stage => stage.item.tone ? colorForTone(stage.item.tone) : colors[Math.min(stage.index, colors.length - 1)]);
    rows.append('text').attr('class', 'funnel-number').attr('x', left + maxWidth / 2).attr('y', stage => barY(stage) + 27)
      .attr('fill', palette.paper).attr('font-size', 13).attr('font-weight', 900).attr('text-anchor', 'middle').text(stage => stage.index + 1);
    rows.append('text').attr('fill', palette.ink).attr('font-size', 12).attr('font-weight', 800).attr('text-anchor', compact ? 'start' : 'end')
      .each(function(stage) {
        renderLineBlock(d3.select(this), stage.title, {
          x: compact ? left : left - 14, y: compact ? 12 : stage.h / 2 - (stage.title.length - 1) * 8 + 4, lineHeight: 16,
        });
      });
    rows.append('text').attr('fill', palette.ink).attr('font-size', 12).attr('font-weight', 800)
      .each(function(stage) {
        renderLineBlock(d3.select(this), stage.valueLines, {
          x: compact ? left : width - right + 14, y: compact ? barY(stage) + 62 : stage.h / 2 - (stage.valueLines.length - 1) * 8 + 4, lineHeight: 16,
        });
      });
    withTooltip(rows, stage => tooltipHtml(stage.item.label, [stage.group, stage.value, ...stage.notes]));
    const notes = d3.select(element).append('dl').attr('class', 'funnel-source-notes');
    for (const stage of stages) {
      if (!stage.notes.length) continue;
      notes.append('dt').text([stage.group, stage.item.label].filter(Boolean).join(' / '));
      notes.selectAll(null).data(stage.notes).enter().append('dd').text(note => note);
    }
    const print = d3.select(element).append('ol').attr('class', 'funnel-print-stages');
    const printRows = print.selectAll('li').data(stages).join('li');
    printRows.append('strong').text(stage => [stage.group, stage.item.label].filter(Boolean).join(' / '));
    printRows.append('p').text(stage => stage.value);
    printRows.selectAll('p.funnel-print-note').data(stage => stage.notes).join('p').attr('class', 'funnel-print-note').text(note => note);
    wrapper.remove();
  };

  const renderWaterfall = (element, payload) => {
    const layout = payload.waterfallLayout;
    if (layout.mode === 'independent') {
      renderBar(element, payload);
      d3.select(element).insert('p', ':first-child').attr('class', 'figure-note waterfall-independent-notice').text(payload.waterfallLabels.independent);
      return;
    }
    const details = waterfallValueTable(payload.data, {
      valueLabel: payload.waterfallLabels.value, contextLabel: payload.waterfallLabels.context,
      metadataLabel: payload.waterfallLabels.metadata,
    });
    const points = arr(payload.data.items).map((item, index) => ({
      ...item, ...layout.spans[index], index, label: item.label ?? item.name ?? `${payload.itemLabel} ${index + 1}`,
      notes: String(details.rows[index].values[0].detail ?? '').split('\n').filter(Boolean),
    }));
    const { svg, width } = svgBase(element, 360, Math.max(360, points.length * 88 + 90));
    const wrapper = createSvgTextWrapper(svg);
    const domain = d3.extent([0, ...points.flatMap(point => [point.from, point.to])]);
    const maximumLabelWidth = (width - 96) / points.length - 10;
    points.forEach(point => {
      point.endpoint = layout.mode === 'balanced' && (point.index === 0 || point.index === points.length - 1);
      point.color = point.tone ? colorForTone(point.tone) : point.endpoint ? palette.claret : point.to < point.from ? palette.risk : palette.positive;
      point.lines = wrapper.wrap(point.label, { fontSize: 12, fontWeight: 800, maxWidth: maximumLabelWidth, maxLines: 3 });
      point.valueLines = wrapper.wrap([valueLabel(point), point.unit].filter(value => value != null && value !== '').join(' '),
        { fontSize: 12, fontWeight: 800, maxWidth: maximumLabelWidth });
    });
    const bottom = 44 + Math.max(...points.map(point => point.lines.length)) * 15;
    const top = 42 + Math.max(...points.map(point => point.valueLines.length)) * 15;
    const height = Math.max(360, top + bottom + 220);
    svg.attr('viewBox', `0 0 ${width} ${height}`);
    scrollableSvg(element, svg, width, height, payload);
    const x = d3.scaleBand().domain(points.map(point => point.index)).range([70, width - 26]).padding(0.28);
    const y = d3.scaleLinear().domain(domain[0] === domain[1] ? [0, 1] : domain).nice().range([height - bottom, top]);
    svg.append('rect').attr('class', 'waterfall-panel').attr('x', 70).attr('y', top)
      .attr('width', width - 96).attr('height', height - bottom - top).attr('rx', 18).attr('fill', '#fffaf5');
    svg.append('text').attr('x', 70).attr('y', 24).attr('fill', palette.muted).attr('font-size', 12).attr('font-weight', 800)
      .text(payload.waterfallLabels.bridge);
    axisLeft(svg, y, 62);
    svg.append('line').attr('x1', 70).attr('x2', width - 26).attr('y1', y(0)).attr('y2', y(0))
      .attr('stroke', palette.border).attr('stroke-dasharray', '4 4');
    svg.append('g').selectAll('path').data(points.slice(0, -1)).join('path').attr('class', 'waterfall-connector')
      .attr('d', (point, index) => {
        const next = points[index + 1], x1 = x(point.index) + x.bandwidth(), x2 = x(next.index);
        return `M${x1},${y(point.to)} H${(x1 + x2) / 2} V${y(next.endpoint ? next.to : next.from)} H${x2}`;
      }).attr('fill', 'none').attr('stroke', palette.muted).attr('stroke-opacity', 0.65).attr('stroke-dasharray', '5 4');
    const bars = svg.append('g').selectAll('g').data(points).join('g').attr('class', 'waterfall-step');
    bars.append('rect').attr('class', 'waterfall-bar').attr('x', point => x(point.index))
      .attr('y', point => y(Math.max(point.from, point.to))).attr('width', x.bandwidth())
      .attr('height', point => Math.abs(y(point.to) - y(point.from)))
      .attr('rx', 8).attr('fill', point => point.color).attr('stroke', palette.paper).attr('stroke-width', 2.5);
    const inside = point => Math.abs(y(point.to) - y(point.from)) >= point.valueLines.length * 15 + 12;
    bars.append('text').attr('class', 'waterfall-value').attr('fill', point => inside(point) ? palette.paper : palette.ink)
      .attr('font-size', 12).attr('font-weight', 800).attr('text-anchor', 'middle')
      .each(function(point) {
        renderLineBlock(d3.select(this), point.valueLines, {
          x: x(point.index) + x.bandwidth() / 2,
          y: inside(point) ? (y(point.from) + y(point.to)) / 2 - (point.valueLines.length - 1) * 7.5 + 4
            : y(Math.max(point.from, point.to)) - 8 - (point.valueLines.length - 1) * 15,
          lineHeight: 15,
        });
      });
    bars.append('text').attr('fill', palette.ink).attr('font-size', 12).attr('font-weight', 800).attr('text-anchor', 'middle')
      .each(function(point) { renderLineBlock(d3.select(this), point.lines, { x: x(point.index) + x.bandwidth() / 2, y: height - bottom + 24, lineHeight: 15 }); });
    bars.append('text').attr('class', 'waterfall-role').attr('x', point => x(point.index) + x.bandwidth() / 2)
      .attr('y', height - 10).attr('text-anchor', 'middle').attr('fill', palette.muted).attr('font-size', 10).attr('font-weight', 800)
      .text(point => point.endpoint ? payload.waterfallLabels.total : point.to < point.from ? payload.waterfallLabels.decrease
        : point.to > point.from ? payload.waterfallLabels.increase : payload.waterfallLabels.unchanged);
    withTooltip(bars, point => tooltipHtml(point.label, [String(valueLabel(point)), ...point.notes]));
    wrapper.remove();
  };

  const layoutRangeAxis = (axis) => {
    const nodes = Array.from(axis.children);
    nodes.forEach((node) => { node.hidden = false; });
    const visible = new Set(rangeAxisTickIndices(nodes.map((node) => node.getBoundingClientRect())));
    nodes.forEach((node, index) => { node.hidden = !visible.has(index); });
  };
  const layoutRangeAxes = () => document.querySelectorAll('.range-axis').forEach(layoutRangeAxis);

  const renderRange = (element, payload) => {
    const items = arr(payload.data.items);
    if (!items.length) return;
    const lowOf = (item) => numberValue(item.low ?? item.min);
    const highOf = (item) => numberValue(item.high ?? item.max ?? item.value);
    const midOf = (item) => numberValue(rangeCenterValue(item) ?? ((lowOf(item) + highOf(item)) / 2));
    const min = Math.min(...items.map(lowOf), ...items.map(midOf), 0);
    const max = Math.max(...items.map(highOf), ...items.map(midOf), 1);
    const span = Math.max(max - min, 1e-9);
    const pct = (value) => `${((value - min) / span) * 100}%`;
    const formatNumber = (value) => {
      const n = Number(value);
      if (!Number.isFinite(n)) return String(value ?? '');
      const abs = Math.abs(n);
      if (abs >= 1000) return d3.format(',.0f')(n);
      if (abs >= 100) return d3.format(',.1f')(n);
      return d3.format(',.2~f')(n);
    };
    const tickFormat = (value) => formatNumber(value);
    const ticks = d3.scaleLinear().domain([min, max]).nice().ticks(4).filter((value) => value >= min && value <= max);
    if (ticks[0] !== min) ticks.unshift(min);
    if (ticks[ticks.length - 1] !== max) ticks.push(max);
    d3.select(element).selectAll('*').remove();
    const root = d3.select(element).append('div').attr('class', 'range-list');
    items.forEach((item) => {
      const low = lowOf(item);
      const mid = midOf(item);
      const high = highOf(item);
      const fill = colorForTone(item.tone);
      const labels = {
        low: formatRangeValue(low),
        mid: rangeCenterValue(item) == null ? formatNumber(mid) : formatRangeValue(mid),
        high: formatRangeValue(high),
      };
      const summaryText = item.displayValue ?? `${labels.low} – ${labels.high}`;
      const row = root.append('div').attr('class', 'range-row')
        .datum({ label: safeText(item), low, mid, high, labels, summary: summaryText, notes: figureValueNotes(item) });
      row.append('div').attr('class', 'range-row-label').text(safeText(item));
      const trackCell = row.append('div').attr('class', 'range-row-track-cell');
      const track = trackCell.append('div').attr('class', 'range-row-track');
      track.append('div').attr('class', 'range-row-band')
        .style('left', pct(low))
        .style('width', `calc(${pct(high)} - ${pct(low)})`)
        .style('background', fill);
      track.append('div').attr('class', 'range-row-mid-dot').style('left', pct(mid));
      const meta = trackCell.append('div').attr('class', 'range-row-meta');
      meta.append('span').attr('class', 'range-row-meta-low').text(labels.low);
      meta.append('span').attr('class', 'range-row-meta-mid').text(`${payload.rangeLabels.midInline} ${labels.mid}`);
      meta.append('span').attr('class', 'range-row-meta-high').text(labels.high);
      row.append('div').attr('class', 'range-row-summary').text(summaryText);
      row.selectAll('div.range-row-detail').data(figureValueNotes(item)).join('div')
        .attr('class', 'range-row-detail').text((note) => note);
    });
    const axis = root.append('div').attr('class', 'range-axis');
    ticks.forEach((tickValue) => {
      axis.append('span')
        .attr('class', 'range-axis-tick')
        .style('left', pct(tickValue))
        .text(tickFormat(tickValue));
    });
    layoutRangeAxis(axis.node());
    withTooltip(root.selectAll('.range-row'), (d) => tooltipHtml(d.label, [`${payload.rangeLabels.low} ${d.labels.low}`, `${payload.rangeLabels.mid} ${d.labels.mid}`, `${payload.rangeLabels.high} ${d.labels.high}`, ...d.notes]));
  };

  const renderQuadrant = (element, payload, minimumHeight = 0) => {
    const points = arr(payload.data.points);
    const xAxis = payload.quadrantAxes.x;
    const yAxis = payload.quadrantAxes.y;
    const xAxisLabel = xAxis.label;
    const yAxisLabel = yAxis.label;
    const containerWidth = element.getBoundingClientRect().width || 760;
    const compact = containerWidth < 640;
    const { svg, width, height } = svgBase(element, Math.max(compact ? 420 : 380, Math.ceil(points.length / 10) * 60 + 320, minimumHeight));
    const margin = { top: 54, right: compact ? 24 : 42, bottom: 64, left: 72 };
    const textWrapper = createSvgTextWrapper(svg);
    const axisLines = (label, maxWidth) => textWrapper.wrap(label, {
      fontSize: chartFont.axis, fontWeight: fontWeight('label'), maxWidth, maxLines: 3,
    });
    const tickValues = (scale) => [...new Set([...scale.domain(), ...scale.ticks(2)])].sort((a, b) => a - b);
    const tickFormat = d3.format('~g');
    const y = d3.scaleLinear().domain(yAxis.domain);
    if (!yAxis.declared) y.nice(4);
    const tickWidth = Math.max(...tickValues(y).map(value => textWrapper.measure(tickFormat(value), {
      fontSize: chartFont.axis, fontWeight: fontWeight('strong'),
    })));
    let xLines, yLines;
    for (let pass = 0; pass < 3; pass++) {
      xLines = axisLines(xAxisLabel, width - margin.left - margin.right);
      margin.bottom = 42 + xLines.length * chartFont.lineHeight.small;
      yLines = axisLines(yAxisLabel, height - margin.top - margin.bottom);
      const left = Math.max(72, Math.ceil(yLines.length * chartFont.lineHeight.small + tickWidth + 24));
      if (left === margin.left) break;
      margin.left = left;
    }
    const plotW = width - margin.left - margin.right;
    const plotH = height - margin.top - margin.bottom;
    const x = d3.scaleLinear().domain(xAxis.domain).range([margin.left, width - margin.right]);
    y.range([height - margin.bottom, margin.top]);
    if (!xAxis.declared) x.nice(4);
    const panel = svg.append('g').attr('class', 'quadrant-plot');
    panel.append('rect')
      .attr('x', margin.left)
      .attr('y', margin.top)
      .attr('width', plotW)
      .attr('height', plotH)
      .attr('rx', 18)
      .attr('fill', '#fffaf5')
      .attr('stroke', palette.border);
    const clip = svg.append('defs').append('clipPath').attr('id', `${payload.id}-quadrant-panel`);
    clip.append('rect').attr('x', margin.left).attr('y', margin.top).attr('width', plotW).attr('height', plotH).attr('rx', 18);
    const fills = ['rgba(15,118,110,0.07)', 'rgba(153,15,61,0.07)', 'rgba(180,35,24,0.055)', 'rgba(184,134,11,0.075)'];
    panel.append('g').attr('clip-path', `url(#${payload.id}-quadrant-panel)`)
      .selectAll('rect').data(fills).join('rect').attr('class', 'quadrant-zone')
      .attr('x', (_fill, index) => margin.left + index % 2 * plotW / 2)
      .attr('y', (_fill, index) => margin.top + Math.floor(index / 2) * plotH / 2)
      .attr('width', plotW / 2).attr('height', plotH / 2).attr('fill', fill => fill);
    const dividers = panel.append('g').attr('class', 'quadrant-dividers').attr('stroke', palette.claret)
      .attr('stroke-width', 1.2).attr('stroke-dasharray', '5 5').attr('opacity', 0.55);
    dividers.append('line').attr('x1', margin.left + plotW / 2).attr('x2', margin.left + plotW / 2)
      .attr('y1', margin.top).attr('y2', height - margin.bottom);
    dividers.append('line').attr('x1', margin.left).attr('x2', width - margin.right)
      .attr('y1', margin.top + plotH / 2).attr('y2', margin.top + plotH / 2);
    panel.append('circle').attr('class', 'quadrant-center-ring').attr('cx', margin.left + plotW / 2).attr('cy', margin.top + plotH / 2)
      .attr('r', 5).attr('fill', palette.paper).attr('stroke', palette.claret).attr('stroke-width', 1.5);
    svg.append('g')
      .attr('class', 'quadrant-x-axis')
      .attr('transform', `translate(0,${height - margin.bottom})`)
      .call(d3.axisBottom(x).tickValues(tickValues(x)).tickFormat(tickFormat).tickPadding(6).tickSizeOuter(0))
      .call((axis) => axis.select('.domain').attr('stroke', palette.border))
      .call((axis) => axis.selectAll('line').attr('stroke', palette.border).attr('opacity', 0.65))
      .call((axis) => axis.selectAll('text').attr('fill', palette.muted).attr('font-size', chartFont.axis).attr('font-weight', fontWeight('strong')));
    svg.append('g')
      .attr('class', 'quadrant-y-axis')
      .attr('transform', `translate(${margin.left},0)`)
      .call(d3.axisLeft(y).tickValues(tickValues(y)).tickFormat(tickFormat).tickPadding(6).tickSizeOuter(0))
      .call((axis) => axis.select('.domain').attr('stroke', palette.border))
      .call((axis) => axis.selectAll('line').attr('stroke', palette.border).attr('opacity', 0.65))
      .call((axis) => axis.selectAll('text').attr('fill', palette.muted).attr('font-size', chartFont.axis).attr('font-weight', fontWeight('strong')));
    svg.selectAll('.domain').attr('stroke', palette.border);
    svg.selectAll('.tick line').attr('stroke', palette.border).attr('opacity', 0.65);
    const xTitle = svg.append('text').attr('class', 'quadrant-x-title').attr('text-anchor', 'middle').attr('fill', palette.ink).attr('font-size', chartFont.axis).attr('font-weight', fontWeight('label'));
    renderLineBlock(xTitle, xLines, { x: margin.left + plotW / 2, y: height - margin.bottom + 38, lineHeight: chartFont.lineHeight.small });
    const yTitle = svg.append('text').attr('class', 'quadrant-y-title').attr('text-anchor', 'middle')
      .attr('transform', `translate(${Math.max(22, (yLines.length - 1) * chartFont.lineHeight.small / 2 + 21)},${margin.top + plotH / 2}) rotate(-90)`)
      .attr('fill', palette.ink).attr('font-size', chartFont.axis).attr('font-weight', fontWeight('label'));
    renderLineBlock(yTitle, yLines, { y: -(yLines.length - 1) * chartFont.lineHeight.small / 2, lineHeight: chartFont.lineHeight.small });
    const plotPoints = points.map((point, index) => ({
      ...point, _index: index, _valueX: point.x, _valueY: point.y,
      notes: figureValueNotes(point), x: x(point.x), y: y(point.y),
    }));
    const radius = compact ? 15 : 17;
    const bounds = {
      left: margin.left, right: width - margin.right, top: margin.top, bottom: height - margin.bottom,
    };
    const labels = quadrantLabelPositions(plotPoints, bounds, radius);
    if (labels.some((label, index) => label.x - radius < bounds.left || label.x + radius > bounds.right
      || label.y - radius < bounds.top || label.y + radius > bounds.bottom
      || labels.slice(index + 1).some(other => Math.hypot(label.x - other.x, label.y - other.y) < radius * 2 + 2))) {
      const maximumHeight = margin.top + margin.bottom + points.length * (radius * 2 + 12);
      textWrapper.remove();
      if (height >= maximumHeight) throw new Error('Quadrant markers cannot fit within the available plot width');
      return renderQuadrant(element, payload, Math.min(height + 120, maximumHeight));
    }
    svg.append('g').selectAll('line').data(plotPoints.filter(point =>
      Math.hypot(labels[point._index].x - point.x, labels[point._index].y - point.y) > 0.5)).join('line').attr('class', 'quadrant-label-leader')
      .attr('x1', d => d.x).attr('y1', d => d.y)
      .attr('x2', d => labels[d._index].x).attr('y2', d => labels[d._index].y)
      .attr('stroke', (d) => colorForTone(d.tone)).attr('stroke-width', 1.2);
    const dots = svg.append('g').selectAll('g.quadrant-point').data(plotPoints).join('g').attr('class', 'quadrant-point').attr('transform', (d) => `translate(${d.x},${d.y})`);
    dots.append('circle').attr('class', 'quadrant-coordinate-dot').attr('r', 5).attr('fill', (d) => colorForTone(d.tone));
    const badges = dots.append('g').attr('class', 'quadrant-point-label')
      .attr('transform', (d) => `translate(${labels[d._index].x - d.x},${labels[d._index].y - d.y})`);
    badges.append('circle').attr('class', 'quadrant-number-marker').attr('r', radius)
      .attr('fill', d => colorForTone(d.tone)).attr('stroke', palette.paper).attr('stroke-width', 3);
    badges.append('circle').attr('r', compact ? 7 : 8).attr('fill', palette.paper).attr('opacity', 0.22);
    badges.append('text').attr('y', 4).attr('text-anchor', 'middle').attr('fill', palette.paper)
      .attr('font-size', 12).attr('font-weight', 900).text(d => d._index + 1);
    // Coincident points keep their coordinates; the legend exposes every item.
    dots.each(function(d) { addTitle(d3.select(this), `${d.label}: ${xAxisLabel} ${d._valueX}; ${yAxisLabel} ${d._valueY}`); });
    withTooltip(dots, (d) => tooltipHtml(d.label, [`${xAxisLabel}: ${d._valueX}`, `${yAxisLabel}: ${d._valueY}`, ...d.notes]));
    // HTML legend: responsive flow grid, wraps cleanly across widths.
    const legendHost = d3.select(element).append('div').attr('class', 'quadrant-legend');
    const legendItems = legendHost.selectAll('div.quadrant-legend-item').data(plotPoints).join('div')
      .attr('class', 'quadrant-legend-item');
    legendItems.append('span')
      .attr('class', 'quadrant-legend-badge')
      .style('background', (d) => colorForTone(d.tone))
      .text((d) => d._index + 1);
    legendItems.append('span').attr('class', 'quadrant-legend-label').text((d) => d.label);
    withTooltip(legendItems, (d) => tooltipHtml(d.label, [`${xAxisLabel}: ${d._valueX}`, `${yAxisLabel}: ${d._valueY}`, ...d.notes]));
    textWrapper.remove();
  };

  const renderHeatmap = (element, payload) => {
    const columns = arr(payload.data.columns).map((column) => ({
      label: safeText(column), notes: figureItemNotes({ detail: column?.detail, note: column?.note }),
    }));
    const rows = arr(payload.data.rows).map((row) => {
      const label = safeText(row?.label);
      const notes = figureItemNotes({ note: row?.note });
      return {
        label, notes,
        cells: arr(row?.values).map((cell, colIndex) => {
          const rawText = displayCellText(matrixCellText(cell), payload.locale);
          const cellNotes = figureItemNotes({ detail: cell?.detail, note: cell?.note })
            .map((note) => displayCellText(note, payload.locale));
          const column = columns[colIndex];
          return {
            row: label, column: column?.label ?? '', text: rawText || '—',
            isEmpty: rawText === '', tone: cell?.tone, notes: cellNotes,
            columnNotes: column?.notes ?? [],
            tooltipNotes: [...new Set([...notes, ...(column?.notes ?? []), ...cellNotes])],
          };
        }),
      };
    });
    d3.select(element).selectAll('*').remove();
    const root = d3.select(element).append('div').attr('class', 'matrix-table')
      .attr('role', 'region')
      .attr('tabindex', 0).attr('aria-label', element.getAttribute('aria-label'));
    root.style('--matrix-cols', String(Math.max(columns.length, 1)));
    // Desktop / tablet: CSS grid table. Header row first, then data rows.
    const grid = root.append('div').attr('class', 'matrix-grid').attr('role', 'table');
    const headerRow = grid.append('div').attr('class', 'matrix-row matrix-row-head').attr('role', 'row');
    headerRow.append('div').attr('class', 'matrix-cell matrix-corner').attr('role', 'columnheader').attr('aria-hidden', 'true');
    headerRow.selectAll('div.matrix-col-head').data(columns).join('div')
      .attr('class', 'matrix-cell matrix-col-head')
      .attr('role', 'columnheader')
      .each(function (column) {
        const header = d3.select(this);
        header.append('div').attr('class', 'matrix-col-label').text(column.label);
        header.selectAll('div.matrix-column-detail').data(column.notes).join('div')
          .attr('class', 'matrix-column-detail matrix-qualification').text((note) => note);
      });
    rows.forEach((row) => {
      const rowEl = grid.append('div').attr('class', 'matrix-row matrix-row-body').attr('role', 'row');
      const header = rowEl.append('div').attr('class', 'matrix-cell matrix-rowlabel').attr('role', 'rowheader');
      header.append('div').attr('class', 'matrix-row-name').text(row.label);
      header.selectAll('div.matrix-row-note').data(row.notes).join('div')
        .attr('class', 'matrix-row-note matrix-qualification').text((note) => note);
      row.cells.forEach((cell) => {
        const dataCell = rowEl.append('div')
          .attr('class', `matrix-cell matrix-data matrix-tone-${cell.tone || 'neutral'}${cell.isEmpty ? ' matrix-empty' : ''}`)
          .attr('role', 'cell')
          .datum(cell);
        dataCell.append('div').attr('class', 'matrix-cell-value').text(cell.text);
        dataCell.selectAll('div.matrix-cell-detail').data(cell.notes).join('div')
          .attr('class', 'matrix-cell-detail matrix-qualification').text((note) => note);
      });
    });
    withTooltip(grid.selectAll('.matrix-data'), (d) => tooltipHtml(`${d.row} × ${d.column}`, [d.text, ...d.tooltipNotes]));
    // Narrow viewports: card-per-row layout (one card per data row, listing
    // each column as a labelled key/value). CSS picks which one is visible.
    const cards = root.append('div').attr('class', 'matrix-cards');
    rows.forEach((row) => {
      const card = cards.append('div').attr('class', 'matrix-card');
      card.append('div').attr('class', 'matrix-card-title').text(row.label);
      card.selectAll('div.matrix-row-note').data(row.notes).join('div')
        .attr('class', 'matrix-row-note matrix-qualification').text((note) => note);
      row.cells.forEach((cell) => {
        // Skip drawing a card row entry when the cell is empty AND has no
        // tone or qualification worth showing.
        if (cell.isEmpty && !cell.tone && !cell.notes.length && !cell.columnNotes.length) return;
        const item = card.append('div').attr('class', `matrix-card-item matrix-tone-${cell.tone || 'neutral'}${cell.isEmpty ? ' matrix-empty' : ''}`);
        item.datum(cell);
        item.append('div').attr('class', 'matrix-card-key').text(cell.column);
        item.selectAll('div.matrix-column-detail').data(cell.columnNotes).join('div')
          .attr('class', 'matrix-column-detail matrix-qualification').text((note) => note);
        item.append('div').attr('class', 'matrix-card-val').text(cell.text);
        item.selectAll('div.matrix-card-detail').data(cell.notes).join('div')
          .attr('class', 'matrix-card-detail matrix-qualification').text((note) => note);
      });
    });
    withTooltip(cards.selectAll('.matrix-card-item'), (d) => tooltipHtml(`${d.row} × ${d.column}`, [d.text, ...d.tooltipNotes]));
  };

  const renderCohort = (element, payload) => {
    const columns = arr(payload.data.columns);
    const rows = arr(payload.data.rows);
    const { svg, width, height } = svgBase(element, Math.max(340, rows.length * 58 + 92));
    const margin = { top: 58, right: 24, bottom: 26, left: 156 };
    const x = d3.scaleBand().domain(columns).range([margin.left, width - margin.right]).padding(0.08);
    const y = d3.scaleBand().domain(rows.map((row) => row.label)).range([margin.top, height - margin.bottom]).padding(0.08);
    // Adaptive color scale. Default to retention percentages 0–100 (the
    // canonical cohort use case) but fall back to the observed numeric range
    // so misuses with ordinal scoring (e.g. 0–3) still produce visible
    // contrast instead of a single flat color.
    const numericValues = [];
    for (const row of rows) for (const cell of arr(row.values)) {
      const value = Number(cell?.value ?? String(cell?.label ?? '').replace(/[^0-9.-]/g, ''));
      if (Number.isFinite(value)) numericValues.push(value);
    }
    const dataMin = numericValues.length ? Math.min(...numericValues) : 0;
    const dataMax = numericValues.length ? Math.max(...numericValues) : 100;
    const fitsPercent = dataMin >= 0 && dataMax <= 100 && dataMax > 10;
    const colorDomain = fitsPercent
      ? [0, 50, 100]
      : dataMax === dataMin
        ? [dataMin, dataMin, dataMax + 1]
        : [dataMin, (dataMin + dataMax) / 2, dataMax];
    const color = d3.scaleLinear().domain(colorDomain).range(['#f4c7bd', '#f2d8a0', '#0f766e']);
    svg.append('g').selectAll('text').data(columns).join('text').attr('x', (d) => x(d) + x.bandwidth() / 2).attr('y', margin.top - 16).attr('text-anchor', 'middle').attr('fill', palette.ink).attr('font-size', chartFont.axis).attr('font-weight', fontWeight('strong')).text((d) => labelText(d, 14));
    svg.append('g').selectAll('text').data(rows).join('text').attr('x', margin.left - 12).attr('y', (d) => y(d.label) + y.bandwidth() / 2 + 4).attr('text-anchor', 'end').attr('fill', palette.ink).attr('font-size', chartFont.axis).attr('font-weight', fontWeight('strong')).each(function(d) {
      renderWrappedText(d3.select(this), d.label, { maxChars: 20, maxLines: 2, lineHeight: chartFont.lineHeight.tight });
    });
    const cells = [];
    rows.forEach((row) => arr(row.values).forEach((cell, colIndex) => {
      const value = Number(cell?.value ?? String(cell?.label ?? '').replace(/[^0-9.-]/g, ''));
      cells.push({
        row: row.label, column: columns[colIndex], cell, value: Number.isFinite(value) ? value : 0,
        text: displayCellText(safeText(cell), payload.locale),
        detail: displayCellText(cell?.detail, payload.locale),
      });
    }));
    const g = svg.append('g').selectAll('g').data(cells).join('g');
    g.append('rect').attr('x', (d) => x(d.column)).attr('y', (d) => y(d.row)).attr('width', x.bandwidth()).attr('height', y.bandwidth()).attr('rx', 7).attr('fill', (d) => color(d.value)).attr('stroke', '#fff7ef').attr('stroke-width', 3);
    g.append('text').attr('x', (d) => x(d.column) + x.bandwidth() / 2).attr('y', (d) => y(d.row) + y.bandwidth() / 2).attr('text-anchor', 'middle').attr('dominant-baseline', 'middle').attr('fill', palette.ink).attr('font-size', chartFont.small).attr('font-weight', fontWeight('strong')).each(function(d) {
      const cellLabel = d.text || (Number.isFinite(d.value) ? String(d.value) : '');
      renderWrappedText(d3.select(this), cellLabel, { maxChars: Math.max(7, Math.floor(x.bandwidth() / 7)), maxLines: Math.max(1, Math.floor(y.bandwidth() / 16)), lineHeight: chartFont.lineHeight.tight });
    });
    g.each(function(d) { addTitle(d3.select(this), `${d.row} × ${d.column}: ${d.text || d.value}`); });
    withTooltip(g, (d) => tooltipHtml(`${d.row} × ${d.column}`, [d.text || String(d.value), d.detail]));
  };

  const RENDERERS = {
    timeline: renderTimeline,
    flow: renderFlow,
    stack: renderStack,
    pyramid: renderPyramid,
    'journey-map': renderJourneyMap,
    kpi: renderKpi,
    range: renderRange,
    bar: renderBar,
    funnel: renderFunnel,
    waterfall: renderWaterfall,
    matrix: renderHeatmap,
    cohort: renderCohort,
    quadrant: renderQuadrant,
    dag: renderDag,
  };

  const normalizeRenderedTypography = (element) => {
    d3.select(element)
      .selectAll('svg text')
      .attr('font-family', chartFont.family);
  };

  const normalizeRenderedFlatStyle = (element) => {
    const svg = d3.select(element).select('svg');
    svg.selectAll('filter').remove();
    svg.selectAll('[filter]').attr('filter', null);
    svg.selectAll('[style*="drop-shadow"], [style*="box-shadow"]').style('filter', null).style('box-shadow', null);
  };

  const renderD3 = (element, payload) => {
    try {
      const result = RENDERERS[payload.type]?.(element, payload);
      normalizeRenderedTypography(element);
      normalizeRenderedFlatStyle(element);
      return result;
    } catch (error) {
      console.error(`[FigureRenderer] Failed to render ${payload?.id ?? payload?.type ?? 'figure'}`, error);
      d3.select(element).selectAll('*').remove();
      d3.select(element).append('div').attr('class', 'figure-render-error').text(element.dataset.errorLabel);
      return null;
    }
  };

  const payloadByScript = new WeakMap();
  const scriptByChartId = new Map();
  const chartScripts = () => Array.from(document.querySelectorAll('script.figure-chart-data'));
  const payloadForScript = (script) => {
    if (!payloadByScript.has(script)) payloadByScript.set(script, JSON.parse(script.textContent || '{}'));
    return payloadByScript.get(script);
  };

  const RESIZE_RERENDER_DELTA_PX = 32;
  const RESIZE_RERENDER_DEBOUNCE_MS = 180;
  const pendingResizeRenders = new WeakMap();
  const flushResizeRender = (element) => {
    const handle = pendingResizeRenders.get(element);
    if (handle) {
      window.clearTimeout(handle);
      pendingResizeRenders.delete(element);
    }
    const script = scriptByChartId.get(element.id);
    if (!script) return;
    const payload = payloadForScript(script);
    renderD3(element, payload);
    script.dataset.rendered = 'true';
