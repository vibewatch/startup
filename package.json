{
  "name": "startup-scripts",
  "private": true,
  "type": "module",
  "scripts": {
    "build:contracts": "node .agents/skills/startup-research/scripts/build-contract-docs.mjs",
    "build:rules": "node .agents/skills/startup-research/scripts/build-rules-doc.mjs",
    "build:references": "npm run build:contracts && npm run build:rules",
    "check:automation-config": "node .agents/skills/startup-research/scripts/check-automation-config.mjs",
    "check:chapter-workers": "node .agents/skills/startup-research/scripts/check-chapter-workers.mjs",
    "check:research-profile": "node .agents/skills/startup-research/scripts/check-research-profile.mjs",
    "check:report-yaml-current": "node .agents/skills/startup-research/scripts/migrate-report-yaml.mjs",
    "check:workflow-config": "node .agents/skills/startup-research/scripts/check-workflow-config.mjs",
    "check:revision-graph": "node .agents/skills/startup-research/scripts/check-revision-graph.mjs",
    "reports:duplicates": "node .agents/skills/startup-research/scripts/dedupe-reports.mjs",
    "reports:dedupe": "node .agents/skills/startup-research/scripts/dedupe-reports.mjs --apply",
    "reports:migrate-yaml": "node .agents/skills/startup-research/scripts/migrate-report-yaml.mjs --apply",
    "research:plan": "node .agents/skills/startup-research/scripts/build-search-plan.mjs",
    "research:bootstrap": "node .agents/skills/startup-research/scripts/execute-search-plan.mjs",
    "research:evaluate": "node .agents/skills/startup-research/scripts/evaluate-report.mjs",
    "research:finalize": "node .agents/skills/startup-research/scripts/run-report-finalizer.mjs",
    "research:profile": "node .agents/skills/startup-research/scripts/apply-research-profile.mjs",
    "research:search": "node .agents/skills/startup-research/scripts/search-web.mjs",
    "research:workers": "node .agents/skills/startup-research/scripts/run-chapter-workers.mjs",
    "refresh:plan": "node .agents/skills/startup-research/scripts/plan-refresh-batch.mjs",
    "startup:refresh": "node .agents/skills/startup-research/scripts/create-report-run.mjs --refresh",
    "check:reports-contract": "node .agents/skills/startup-research/scripts/check-reports.mjs",
    "check:translation-sync": "node .agents/skills/translate-zh/scripts/check-preserved-sync.mjs",
    "check:translation-editor": "node .agents/skills/translate-zh/scripts/check-translation-editor.mjs",
    "check:translations-zh": "node .agents/skills/translate-zh/scripts/check-translations.mjs --strict",
    "sync:translations-zh": "node .agents/skills/translate-zh/scripts/sync-preserved-fields.mjs --all reports",
    "audit:translations-zh": "node .agents/skills/translate-zh/scripts/audit-translations.mjs",
    "translate:zh": "node .agents/skills/translate-zh/scripts/run-translation.mjs",
    "validate": "npm run build:references && npm run check:automation-config && npm run check:workflow-config && npm run check:research-profile && npm run check:report-yaml-current && npm run check:chapter-workers && npm run check:revision-graph && npm run check:reports-contract && npm run check:translation-sync && npm run check:translation-editor && npm run check:translations-zh && npm --prefix website run build"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "^5.7.284",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "js-yaml": "^4.1.1"
  }
}
