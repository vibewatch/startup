{
  "name": "startup-scripts",
  "private": true,
  "type": "module",
  "scripts": {
    "build:contracts": "node .agents/skills/startup-research/scripts/build-contract-docs.mjs",
    "build:rules": "node .agents/skills/startup-research/scripts/build-rules-doc.mjs",
    "build:references": "npm run build:contracts && npm run build:rules",
    "check:automation-config": "node .agents/skills/startup-research/scripts/check-automation-config.mjs",
    "check:workflow-config": "node .agents/skills/startup-research/scripts/check-workflow-config.mjs",
    "check:revision-graph": "node .agents/skills/startup-research/scripts/check-revision-graph.mjs",
    "reports:duplicates": "node .agents/skills/startup-research/scripts/dedupe-reports.mjs",
    "reports:dedupe": "node .agents/skills/startup-research/scripts/dedupe-reports.mjs --apply",
    "research:plan": "node .agents/skills/startup-research/scripts/build-search-plan.mjs",
    "research:search": "node .agents/skills/startup-research/scripts/search-web.mjs",
    "startup:refresh": "node .agents/skills/startup-research/scripts/create-report-run.mjs --refresh",
    "check:reports-contract": "node .agents/skills/startup-research/scripts/check-reports.mjs",
    "check:translations-zh": "node .agents/skills/translate-zh/scripts/check-translations.mjs --strict",
    "audit:translations-zh": "node .agents/skills/translate-zh/scripts/audit-translations.mjs",
    "translate:zh": "node .agents/skills/translate-zh/scripts/run-translation.mjs",
    "validate": "npm run build:references && npm run check:automation-config && npm run check:workflow-config && npm run check:revision-graph && npm run check:reports-contract && npm run check:translations-zh && npm --prefix website run build"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "^5.7.284",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "js-yaml": "^4.1.1"
  }
}
